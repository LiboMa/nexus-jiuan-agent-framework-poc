     ...(effectiveSsl === true ? { ssl: { rejectUnauthorized: true } } : effectiveSsl ? { ssl: effectiveSsl } : {}),
   });
   core.on('error', () => {});   // an idle client that died: the pool drops it; callers see errors on their own queries
@@ -349,7 +359,7 @@ export async function acquireNamedLock(conn, name, seconds) {
     if (error?.code === 'ER_LOCK_WAIT_TIMEOUT') return false;
