   const config = parsePgUrl(url);
   if (!Number.isInteger(connectionLimit) || connectionLimit < 1 || connectionLimit > 100) throw configuration('PostgreSQL connection limit is invalid.');
   if (!Number.isInteger(connectTimeout) || connectTimeout < 100 || connectTimeout > 120000) throw configuration('PostgreSQL connect timeout is invalid.');
   if (!Number.isInteger(acquireTimeoutMs) || acquireTimeoutMs < 0 || acquireTimeoutMs > 600000) throw configuration('PostgreSQL acquire timeout is invalid.');
   if (!Number.isInteger(queryTimeoutMs) || queryTimeoutMs < 0 || queryTimeoutMs > 3600000) throw configuration('PostgreSQL query timeout is invalid.');
+  if (!Number.isInteger(lockTimeoutMs) || lockTimeoutMs < 1 || lockTimeoutMs > 3600000) throw configuration('PostgreSQL lock timeout is invalid.');
   const effectiveSsl = ssl === undefined ? config.ssl : ssl;
