补丁 0008 的测试：tests/pg-database.test.mjs（要真 PG 的用 PG_TEST_URL，没给就跳过）。

diff --git a/tests/pg-database.test.mjs b/tests/pg-database.test.mjs
new file mode 100644
index 0000000..25c9fc7
--- /dev/null
+++ b/tests/pg-database.test.mjs
@@ -0,0 +1,150 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createPgPool, parsePgUrl, pgErrorToMysqlShape, toPgPlaceholders, PG_ERROR_CODES } from '../src/pg-database.mjs';
+
+// PostgreSQL 适配层：调用方照旧按 mysql2 的样子用（[rows, fields]、affectedRows、insertId、错误码），读出来的值也和 mysql2 一样。
+// 要真 PG 的用 PG_TEST_URL（库名以 _test 结尾），没给就跳过；占位符、地址解析、错误码映射不要库。
+
+test('占位符：? 依次换成 $1…$n；字符串、E 字符串、$tag$、双引号标识符、注释里的 ? 不换，:: 类型转换不动', () => {
+  const sql = "SELECT ? AS a, '?' AS b, 'it''s ?' AS b2, E'\\'?' AS b3, $q$ ? $q$ AS b4, \"x?\" AS c -- ?\n /* ? */ , ?::int AS d, ? AS e";
+  const { text, count } = toPgPlaceholders(sql);
+  assert.equal(count, 3);
+  assert.equal(text, "SELECT $1 AS a, '?' AS b, 'it''s ?' AS b2, E'\\'?' AS b3, $q$ ? $q$ AS b4, \"x?\" AS c -- ?\n /* ? */ , $2::int AS d, $3 AS e");
+  assert.deepEqual(toPgPlaceholders('SELECT 1'), { text: 'SELECT 1', count: 0 });
+});
+
+test('地址：只认 postgres:// 和 postgresql://，缺省端口 5432；缺用户、口令、库名或库名不合规都报 PG_CONFIGURATION', () => {
+  assert.deepEqual(parsePgUrl('postgres://u:p%40ss@127.0.0.1:5433/jiuan_test'), { host: '127.0.0.1', port: 5433, user: 'u', password: 'p@ss', database: 'jiuan_test', ssl: false });
+  assert.equal(parsePgUrl('postgresql://u:p@db/jiuan?ssl=true').port, 5432);
+  assert.equal(parsePgUrl('postgresql://u:p@db/jiuan?ssl=true').ssl, true);
+  for (const bad of ['', 'mysql://u:p@h/db', 'postgres://u@h/db', 'postgres://u:p@h/', 'postgres://u:p@h:0/db', 'postgres://u:p@h/bad name']) {
+    assert.throws(() => parsePgUrl(bad), error => error.code === PG_ERROR_CODES.CONFIGURATION, bad);
+  }
+});
+
+test('错误码：PG 的 SQLSTATE 换成调用方在查的 mysql2 码，原错误留在 cause', () => {
+  const shaped = (code, message = 'x') => pgErrorToMysqlShape(Object.assign(new Error(message), { code }));
+  assert.deepEqual([shaped('23505').code, shaped('23505').errno], ['ER_DUP_ENTRY', 1062]);
+  assert.deepEqual([shaped('40P01').code, shaped('40P01').errno], ['ER_LOCK_DEADLOCK', 1213]);
+  assert.deepEqual([shaped('55P03').code, shaped('55P03').errno], ['ER_LOCK_WAIT_TIMEOUT', 1205]);
+  assert.deepEqual([shaped('42P01').code, shaped('42P01').errno], ['ER_NO_SUCH_TABLE', 1146]);
+  assert.deepEqual([shaped('42703').code, shaped('42703').errno], ['ER_BAD_FIELD_ERROR', 1054]);
+  assert.equal(shaped('57014', 'canceling statement due to statement timeout').code, 'PROTOCOL_SEQUENCE_TIMEOUT');
+  assert.equal(shaped('57P01').code, 'PROTOCOL_CONNECTION_LOST');
+  assert.equal(shaped('22P02').code, '22P02', '不认识的保留原码');
+  assert.equal(shaped('23505').sqlState, '23505');
+  assert.equal(shaped('23505').cause.code, '23505');
+});
+
+const url = process.env.PG_TEST_URL;
+const real = { skip: !url };
+
+async function withPool(t, options = {}) {
+  assert.match(parsePgUrl(url).database, /_test$/);
+  const pool = createPgPool({ url, connectionLimit: 4, ...options });
+  t.after(() => pool.end());
+  return pool;
+}
+
+test('返回形状：SELECT 是 [rows, fields]；INSERT … RETURNING 给 insertId；UPDATE / DELETE 给 affectedRows（changedRows 同值）', real, async t => {
+  const pool = await withPool(t);
+  await pool.query('DROP TABLE IF EXISTS pg_adapter_shape');
+  await pool.query('CREATE TABLE pg_adapter_shape (id bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, name text NOT NULL)');
+  const [inserted] = await pool.query('INSERT INTO pg_adapter_shape (name) VALUES (?), (?) RETURNING id', ['a', 'b']);
+  assert.equal(inserted.insertId, 1);
+  assert.equal(inserted.affectedRows, 2);
+  const [rows, fields] = await pool.query('SELECT id, name FROM pg_adapter_shape WHERE name = ? ORDER BY id', ['b']);
+  assert.deepEqual(rows, [{ id: 2, name: 'b' }]);
+  assert.deepEqual(fields.map(field => field.name), ['id', 'name']);
+  const [updated] = await pool.query('UPDATE pg_adapter_shape SET name = ? WHERE id > ?', ['z', 0]);
+  assert.deepEqual([updated.affectedRows, updated.changedRows, updated.insertId], [2, 2, 0]);
+  const [deleted] = await pool.execute('DELETE FROM pg_adapter_shape WHERE id = ?', [1]);
+  assert.equal(deleted.affectedRows, 1);
+  await pool.query('DROP TABLE pg_adapter_shape');
+});
+
+test('类型：bigint / count(*) 是数字，超出 2^53 报错；numeric 是字符串；jsonb 是对象；bytea 是 Buffer；smallint 是数字', real, async t => {
+  const pool = await withPool(t);
+  const [[row]] = await pool.query("SELECT 42::bigint AS big, count(*) AS n, 1.50::numeric AS money, '{\"a\":[1,{\"b\":2}]}'::jsonb AS doc, '\\x00ff'::bytea AS raw, 1::smallint AS flag FROM (VALUES (1),(2)) v(x)");
+  assert.equal(row.big, 42);
+  assert.equal(row.n, 2);
+  assert.equal(row.money, '1.50');
+  assert.deepEqual(row.doc, { a: [1, { b: 2 }] });
+  assert.ok(Buffer.isBuffer(row.raw));
+  assert.deepEqual([...row.raw], [0, 255]);
+  assert.equal(row.flag, 1);
+  await assert.rejects(pool.query('SELECT 9007199254740993::bigint AS too_big'), /2\^53|safe integer/);
+});
+
+test('时间：会话是上海时区；Date 参数写进 timestamp(3) 再读出来毫秒不差；? 当 timestamp 原样；库生成的 LOCALTIMESTAMP 是上海墙上时间（比 UTC 快 8 小时）', real, async t => {
+  const pool = await withPool(t);
+  const [[zone]] = await pool.query('SHOW TimeZone');
+  assert.equal(zone.TimeZone ?? zone.timezone, 'Asia/Shanghai');
+  const at = new Date('2026-11-05T08:00:00.123Z');
+  await pool.query('DROP TABLE IF EXISTS pg_adapter_time');
+  await pool.query('CREATE TABLE pg_adapter_time (at timestamp(3) NOT NULL)');
+  await pool.query('INSERT INTO pg_adapter_time (at) VALUES (?)', [at]);
+  const [[stored]] = await pool.query("SELECT at, to_char(at, 'YYYY-MM-DD HH24:MI:SS.MS') AS wall FROM pg_adapter_time");
+  assert.equal(stored.at.toISOString(), '2026-11-05T08:00:00.123Z');
+  assert.equal(stored.wall, '2026-11-05 08:00:00.123', '库里存的是 UTC 的墙上时间，和 mysql2 timezone:Z 一样');
+  const [[echo]] = await pool.query('SELECT ?::timestamp(3) AS at', [at]);
+  assert.equal(echo.at.toISOString(), '2026-11-05T08:00:00.123Z');
+  const [[now]] = await pool.query('SELECT LOCALTIMESTAMP(3) AS local');
+  const ahead = now.local.getTime() - Date.now();
+  assert.ok(Math.abs(ahead - 8 * 3600_000) < 60_000, `库生成的时间应比 UTC 快 8 小时，实际差 ${ahead} 毫秒`);
+  await pool.query('DROP TABLE pg_adapter_time');
+});
+
+test('错误：重复主键 → ER_DUP_ENTRY / 1062；没有的表 → ER_NO_SUCH_TABLE；单条查询超时 → PROTOCOL_SEQUENCE_TIMEOUT，之后连接照常可用', real, async t => {
+  const pool = await withPool(t);
+  await pool.query('DROP TABLE IF EXISTS pg_adapter_dup');
+  await pool.query('CREATE TABLE pg_adapter_dup (id int PRIMARY KEY)');
+  await pool.query('INSERT INTO pg_adapter_dup (id) VALUES (?)', [1]);
+  await assert.rejects(pool.query('INSERT INTO pg_adapter_dup (id) VALUES (?)', [1]), error => error.code === 'ER_DUP_ENTRY' && error.errno === 1062);
+  await assert.rejects(pool.query('SELECT * FROM pg_adapter_nope'), error => error.code === 'ER_NO_SUCH_TABLE');
+  await assert.rejects(pool.query({ sql: 'SELECT pg_sleep(2)', timeout: 200 }), error => error.code === 'PROTOCOL_SEQUENCE_TIMEOUT');
+  const [[ok]] = await pool.query('SELECT 1 AS one');
+  assert.equal(ok.one, 1);
+  await pool.query('DROP TABLE pg_adapter_dup');
+});
+
+test('超时的口径同 mysql2：池上的单条查询用 queryTimeoutMs；getConnection 拿到的连接不带缺省超时（事务、命名锁照自己的）', real, async t => {
+  const pool = await withPool(t, { queryTimeoutMs: 150 });
+  await assert.rejects(pool.query('SELECT pg_sleep(0.4)'), error => error.code === 'PROTOCOL_SEQUENCE_TIMEOUT');
+  const conn = await pool.getConnection();
+  try {
+    await conn.query('SELECT pg_sleep(0.4)');
+    await assert.rejects(conn.query({ sql: 'SELECT pg_sleep(0.4)', timeout: 100 }), error => error.code === 'PROTOCOL_SEQUENCE_TIMEOUT');
+    await conn.query('SELECT pg_sleep(0.3)');   // 显式超时只管那一条
+  } finally { conn.release(); }
+});
+
+test('拿连接超时：连接都占着时，等过 acquireTimeoutMs 就报 PG_POOL_ACQUIRE_TIMEOUT；之后还回来的连接照常能用', real, async t => {
+  const pool = await withPool(t, { connectionLimit: 1, acquireTimeoutMs: 200 });
+  const held = await pool.getConnection();
+  const started = Date.now();
+  await assert.rejects(pool.getConnection(), error => error.code === 'PG_POOL_ACQUIRE_TIMEOUT');
+  const waited = Date.now() - started;
+  assert.ok(waited >= 180 && waited < 2000, `等了 ${waited} 毫秒`);
+  held.release();
+  const [[ok]] = await pool.query('SELECT 1 AS one');
+  assert.equal(ok.one, 1);
+});
+
+test('事务：beginTransaction / rollback 之后没写进去，commit 之后写进去了', real, async t => {
+  const pool = await withPool(t);
+  await pool.query('DROP TABLE IF EXISTS pg_adapter_tx');
+  await pool.query('CREATE TABLE pg_adapter_tx (id int PRIMARY KEY)');
+  const conn = await pool.getConnection();
+  try {
+    await conn.beginTransaction();
+    await conn.query('INSERT INTO pg_adapter_tx (id) VALUES (?)', [1]);
+    await conn.rollback();
+    await conn.beginTransaction();
+    await conn.query('INSERT INTO pg_adapter_tx (id) VALUES (?)', [2]);
+    await conn.commit();
+  } finally { conn.release(); }
+  const [rows] = await pool.query('SELECT id FROM pg_adapter_tx ORDER BY id');
+  assert.deepEqual(rows, [{ id: 2 }]);
+  await pool.query('DROP TABLE pg_adapter_tx');
+});
