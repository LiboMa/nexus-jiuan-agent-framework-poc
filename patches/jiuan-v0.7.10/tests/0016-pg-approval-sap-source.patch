diff --git a/tests/pg-sap-payment.integration.test.mjs b/tests/pg-sap-payment.integration.test.mjs
new file mode 100644
index 0000000..cfe0829
--- /dev/null
+++ b/tests/pg-sap-payment.integration.test.mjs
@@ -0,0 +1,89 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { mkdtemp, rm } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { randomUUID, randomBytes } from 'node:crypto';
+import { createPgPool, migratePg, parsePgUrl } from '../src/pg-database.mjs';
+import { refreshSapPaymentSnapshot } from '../src/sap-payment-refresh.mjs';
+import { openSapPaymentStore } from '../src/sap-payment-store.mjs';
+
+// SAP 付款申请在真 PostgreSQL 上：快照刷新（暂存表、整段替换、失败回滚）和读出来的样子（日期文字、驼峰字段名）。
+// 原来只有一条要开关才跑的 MySQL 测试（RUN_SAP_STORE_INTEGRATION），这里照它的步骤在 PG 上跑。
+const url = process.env.PG_TEST_URL;
+const skip = url ? false : 'PG_TEST_URL is not set; integration database was not contacted';
+
+async function fixture(t) {
+  const config = parsePgUrl(url);
+  assert.equal(config.port, 5434, 'PG_TEST_URL must target the isolated 5434 test instance');
+  assert.match(config.database, /_test$/);
+  const pool = createPgPool({ url, connectionLimit: 4 });
+  await migratePg(pool);
+  const backupDirectory = await mkdtemp(join(tmpdir(), 'sap-refresh-'));
+  t.after(() => rm(backupDirectory, { recursive: true, force: true }));
+  return { pool, backupDirectory };
+}
+
+test('快照刷新：暂存后整段替换；别的日期段的行保留；SAP 中途变了或替换失败，原来的行一条不少', { skip }, async t => {
+  const { pool, backupDirectory } = await fixture(t);
+  const connectionId = `test-sap-${randomUUID()}`, tenantId = 'test-sap', companyCode = '2001', key = randomBytes(32);
+  const scope = [connectionId, tenantId, companyCode];
+  // after hooks run in the order they were added: clean up, then close the pool, in one hook
+  t.after(async () => {
+    await pool.query('DELETE FROM sap_payment_requests WHERE connection_id=?', [connectionId]);
+    await pool.query('DELETE FROM sap_payment_sync_batches WHERE connection_id=?', [connectionId]);
+    await pool.end();
+  });
+  const source = [1, 2].map(n => ({ zfkh: 'TEST', zfkh_item: String(n).padStart(5, '0'), ebelp: '00010', ebeln: `PO${n}`, bukrs: companyCode, zdate: '2026-01-01', menge: '2', brtwr: '5', waers: 'CNY' }));
+  const client = { async queryPaymentPeriod(q) { return { rows: q.skip === 0 ? source : [], total: source.length }; } };
+  const input = { pool, key, connectionId, tenantId, companyCode, client, startDate: '2026-01-01', endDate: '2026-09-21', backupDirectory };
+  const read = async () => (await pool.query('SELECT request_number,line_item FROM sap_payment_requests WHERE connection_id=? AND tenant_id=? AND company_code=? ORDER BY line_item', scope))[0];
+  assert.equal((await refreshSapPaymentSnapshot(input)).persistedRows, 2);
+  assert.deepEqual((await read()).map(row => row.line_item), ['00001', '00002']);
+  const historical = { ...source[0], zfkh: 'HISTORY', zfkh_item: '00099', zdate: '2025-01-01' };
+  await refreshSapPaymentSnapshot({ ...input, startDate: '2025-01-01', endDate: '2025-12-31', client: { async queryPaymentPeriod(q) { return { rows: q.skip ? [] : [historical], total: 1 }; } } });
+  await refreshSapPaymentSnapshot(input);
+  const before = await read();
+  assert.equal(before.length, 3, '替换 2026 年这段，2025 年单独存的那行还在');
+  let calls = 0;
+  await assert.rejects(refreshSapPaymentSnapshot({ ...input, client: { async queryPaymentPeriod(q) { const result = await client.queryPaymentPeriod(q); if (++calls === 3) result.total = null; return result; } } }), { code: 'SAP_PAYMENT_TOTAL_REQUIRED' });
+  assert.deepEqual(await read(), before);
+  const failingPool = { async getConnection() {
+    const c = await pool.getConnection();
+    return { release: () => c.release(), get threadId() { return c.threadId; }, async query(sql, args) {
+      if (String(sql).startsWith('INSERT INTO sap_payment_requests SELECT')) throw new Error('injected promotion failure');
+      return c.query(sql, args);
+    } };
+  } };
+  source.push({ ...source[0], zfkh_item: '00003' });
+  await assert.rejects(refreshSapPaymentSnapshot({ ...input, pool: failingPool }), /injected promotion failure/);
+  assert.deepEqual(await read(), before, '替换失败，原来的快照原样留着');
+  const [[failed]] = await pool.query("SELECT COUNT(*) AS count FROM sap_payment_sync_batches WHERE connection_id=? AND status='failed' AND complete=0", [connectionId]);
+  assert.equal(Number(failed.count), 2);
+});
+
+test('读出来的样子同 MySQL：日期是 YYYY-MM-DD 文字、字段名是驼峰、最近一批的收集时间是 …T…Z', { skip }, async t => {
+  const { pool } = await fixture(t);
+  const connectionId = `test-sap-read-${randomUUID()}`, tenantId = 'test-sap-read';
+  t.after(async () => {
+    await pool.query('DELETE FROM sap_payment_requests WHERE connection_id=?', [connectionId]);
+    await pool.query('DELETE FROM sap_payment_sync_batches WHERE connection_id=?', [connectionId]);
+    await pool.end();
+  });
+  const store = openSapPaymentStore({ pool, key: randomBytes(32), connectionId, tenantId });
+  const batch = await store.startBatch({ companyCode: '3001', startDate: '2026-02-01', endDate: '2026-02-28' });
+  await store.upsertRows({ batchId: batch.id, rows: [
+    { zfkh: 'R1', zfkh_item: '00001', ebelp: '00010', ebeln: 'PO1', bukrs: '3001', butxt: '合成公司', zdate: '2026-02-03', menge: '2', brtwr: '5', waers: 'CNY' },
+    { zfkh: 'R1', zfkh_item: '00002', ebelp: '00010', ebeln: 'PO2', bukrs: '3001', butxt: '合成公司', zdate: '2026-02-09', menge: '1', brtwr: '7', waers: 'CNY' },
+  ] });
+  // 同一行再来一遍：照主键更新，不多出一行
+  await store.upsertRows({ batchId: batch.id, rows: [{ zfkh: 'R1', zfkh_item: '00002', ebelp: '00010', ebeln: 'PO2', bukrs: '3001', butxt: '合成公司', zdate: '2026-02-10', menge: '1', brtwr: '7', waers: 'CNY' }] });
+  await store.finishBatch(batch.id, { status: 'completed', complete: true, collectedAt: '2026-02-28T08:00:00.000Z', rowCount: 2, requestCount: 1, pages: 1 });
+  const actor = null;
+  assert.deepEqual((await store.listCompanies({ actor })).map(row => [row.code, row.name]), [['3001', '合成公司']]);
+  const rows = await store.readRows({ actor, companyCode: '3001' });
+  assert.deepEqual(rows.map(row => [row.date, row.companyCode, row.requestNumber, row.lineItem]), [['2026-02-03', '3001', 'R1', '00001'], ['2026-02-10', '3001', 'R1', '00002']]);
+  assert.deepEqual(await store.dateRange({ actor, companyCode: '3001' }), { startDate: '2026-02-03', endDate: '2026-02-10', count: 2 });
+  const latest = await store.latestSync({ actor, companyCode: '3001' });
+  assert.deepEqual([latest.startDate, latest.endDate, latest.status, latest.complete, latest.rows, latest.collectedAt], ['2026-02-01', '2026-02-28', 'completed', true, 2, '2026-02-28T08:00:00.000Z']);
+});
