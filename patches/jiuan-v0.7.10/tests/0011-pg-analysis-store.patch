diff --git a/tests/pg-analysis-store.integration.test.mjs b/tests/pg-analysis-store.integration.test.mjs
new file mode 100644
index 0000000..f3aba8e
--- /dev/null
+++ b/tests/pg-analysis-store.integration.test.mjs
@@ -0,0 +1,78 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+
+import { createPgPool, migratePg, parsePgUrl } from '../src/pg-database.mjs';
+import { openMySqlAnalysisStore } from '../src/mysql-analysis-store.mjs';
+
+// 正式分析库换到 PostgreSQL 以后 MySQL 自己就会做、PG 要写明白的几处（计划 Review Focus 3、4）：
+// 有两个唯一键的表照样「哪个键撞了就更新哪一行」；排序里的空值和 MySQL 一样（升序在前、降序在后）；
+// 只改「还在跑」的那一行时，第二次说没改到。
+const url = process.env.PG_TEST_URL;
+const skip = url ? false : 'PG_TEST_URL is not set; integration database was not contacted';
+const CONN = 'pg-store-integration';
+const scope = { tenantId: 'pg-tenant', companyId: 'company-a', allCompaniesInTenant: true };
+const report = (n, extra = {}) => ({
+  tenantId: scope.tenantId, docCompanyOID: 'company-a', docCompanyName: 'Company A', companyOID: 'source', expenseReportOID: `pg-report-${n}`,
+  businessCode: `PG-${n}`, formName: 'Corporate Payment', status: '1002', paymentAmount: '1.00', paymentCurrencyCode: 'CNY',
+  lastModifyDate: '2026-10-15T01:00:00Z', approvalHistoryDTOs: [], ...extra,
+});
+
+async function fixture(t) {
+  const config = parsePgUrl(url);
+  assert.equal(config.port, 5434, 'PG_TEST_URL must target the isolated 5434 test instance');
+  assert.match(config.database, /_test$/, 'PG_TEST_URL must target a database ending in _test');
+  const pool = createPgPool({ url, connectionLimit: 4 });
+  t.after(() => pool.end());
+  await pool.query('DROP SCHEMA IF EXISTS public CASCADE');
+  await pool.query('CREATE SCHEMA public');
+  await migratePg(pool);
+  const store = await openMySqlAnalysisStore({ pool, key: Buffer.alloc(32, 91), connectionId: CONN });
+  t.after(() => store.close());
+  await store.migrate();
+  return { pool, store };
+}
+
+test('RF3 附件有两个唯一键：同一个文件既在表单里又在审批历史里（两个附件编号、同一个「单据 + 源附件 + 版本」）→ 整页照样写进去、只留一行；同一页再来一遍也不报错', { skip }, async t => {
+  const { pool, store } = await fixture(t);
+  const file = { attachmentOID: 'att-shared', fileName: 'shared.pdf' };
+  const raw = report(1, { custFormValues: [{ attachmentImages: [file] }],
+    approvalHistoryDTOs: [{ id: 'h1', operation: 2001, operateDate: '2026-10-14T01:00:00Z', attachmentDTOList: [file] }] });
+  await store.upsertPage({ scope, reports: [raw] });
+  await store.upsertPage({ scope, reports: [raw] });
+  const [rows] = await pool.query("SELECT attachment_id, source_version, content_available FROM audit_attachments WHERE source_attachment_id = 'att-shared'");
+  assert.equal(rows.length, 1);
+  assert.equal(rows[0].content_available, 0);
+});
+
+test('RF3 附件编号撞了、「单据 + 源附件 + 版本」没撞（单据出了新版本）→ 更新那一行，和 MySQL 一样', { skip }, async t => {
+  const { pool, store } = await fixture(t);
+  const file = { attachmentOID: 'att-1', fileName: 'one.pdf' };
+  await store.upsertPage({ scope, reports: [report(2, { custFormValues: [{ attachmentImages: [file] }] })] });
+  const [[before]] = await pool.query("SELECT attachment_id, source_version FROM audit_attachments WHERE source_attachment_id = 'att-1'");
+  // 同一个附件编号、新的版本号：直接改库里的版本号，模拟下一页带来的是「编号相同、版本不同」
+  await pool.query("UPDATE audit_attachments SET source_version = 'older' WHERE attachment_id = ?", [before.attachment_id]);
+  await store.upsertPage({ scope, reports: [report(2, { custFormValues: [{ attachmentImages: [file] }] })] });
+  const [rows] = await pool.query("SELECT attachment_id, source_version FROM audit_attachments WHERE source_attachment_id = 'att-1'");
+  assert.deepEqual(rows, [{ attachment_id: before.attachment_id, source_version: before.source_version }]);
+});
+
+test('RF5 空值排序同 MySQL：「我审过的」按最后一次处理时间倒序，没有时间的排在最后', { skip }, async t => {
+  const { store } = await fixture(t);
+  await store.upsertPage({ scope, reports: [report(3), report(4)] });
+  const docs = Object.fromEntries((await store.listApprovalIndexCandidates()).map(item => [item.raw.businessCode, item]));
+  const names = { operatorName: 'FAKE-甲', approverName: 'FAKE-乙', operatorDepartmentName: 'FAKE-丙' };
+  const event = (key, at) => ({ eventKey: key.repeat(64), operatorEmployeeId: 'E1', approverEmployeeId: null, operatorDepartmentOid: 'dept', nodeName: '审批',
+    operation: '2001', category: 'passed', occurredAt: at, names });
+  await store.writeApprovalActors({ documentId: docs['PG-3'].id, version: docs['PG-3'].version, events: [event('a', null)] });
+  await store.writeApprovalActors({ documentId: docs['PG-4'].id, version: docs['PG-4'].version, events: [event('b', '2026-10-18T01:00:00Z')] });
+  const handled = await store.listHandledDocuments({ employeeId: 'E1', companyIds: 'all' });
+  assert.deepEqual(handled.map(row => row.documentId), [docs['PG-4'].id, docs['PG-3'].id]);
+  assert.equal(handled[1].lastActedAt, null);
+});
+
+test('RF4 只改「还在跑」的批次：第一次 updated true，第二次 false（看的是改到的行数）', { skip }, async t => {
+  const { store } = await fixture(t);
+  const batch = await store.createBatch({ scope: { tenantId: scope.tenantId, companyId: 'company-a' }, query: { page: 1 } });
+  assert.deepEqual(await store.abandonBatch(batch.id), { updated: true });
+  assert.deepEqual(await store.abandonBatch(batch.id), { updated: false });
+});
