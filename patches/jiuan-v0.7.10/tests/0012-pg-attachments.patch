@@ -3,26 +3,34 @@ import assert from 'node:assert/strict';
 
 import { lockSnapshot } from '../src/analysis-documents-admin.mjs';
 import { fullSyncLockName } from '../src/full-sync-lock.mjs';
+import { namedLockKey } from '../src/pg-database.mjs';
 
 // HOTFIX-074: the read-only lock and transaction snapshot of the hourly ops summary. It names who
 // holds a lock (a connection id) and how old and in what state the oldest open transaction is;
 // it never reads a statement (trx_query, processlist info), so no SQL or document data can reach it.
 const CONNECTION = 'connection-a';
 
+// PostgreSQL: the transactions come from pg_stat_activity, a lock's holder from pg_locks by the two halves of its key
+const lockHalves = name => { const key = BigInt.asUintN(64, namedLockKey(name)); return [key >> 32n, key & 0xffffffffn]; };
 function fakeDb({ trx = { open: 2, oldest: 75, state: 'LOCK WAIT', operation: 'inserting' }, trxError = null, holders = {}, agents = ['hly.list-sync', 'hly.report-detail'] } = {}) {
   const queries = [];
   return {
     queries,
     async query(sql, params = []) {
       queries.push(sql);
-      if (/information_schema\.innodb_trx/u.test(sql)) {
+      if (/FROM pg_stat_activity/u.test(sql)) {
         if (trxError) throw trxError;
         if (/COUNT\(\*\)/u.test(sql)) return [[{ open: trx.open, oldest: trx.oldest }]];
         return [trx.open ? [{ trx_state: trx.state, trx_operation_state: trx.operation }] : []];
       }
       if (/DISTINCT agent_id/u.test(sql)) return [agents.map(agent_id => ({ agent_id }))];
-      if (/IS_USED_LOCK\(CONCAT\('platform-agent:'/u.test(sql)) return [[{ holder: holders[`agent:${params[0]}`] ?? null }]];
-      if (/IS_USED_LOCK\(\?\)/u.test(sql)) return [[{ holder: holders[`name:${params[0]}`] ?? null }]];
+      if (/FROM pg_locks/u.test(sql)) {
+        const names = [...Object.keys(holders).filter(label => label.startsWith('name:')).map(label => [label, label.slice(5)]),
+          ...agents.map(agent => [`agent:${agent}`, `platform-agent:${agent}`])];
+        const hit = names.find(([, name]) => { const [high, low] = lockHalves(name); return high === params[0] && low === params[1]; });
+        const holder = hit ? holders[hit[0]] ?? null : null;
+        return [holder === null ? [] : [{ pid: holder }]];
+      }
       throw new Error(`unexpected query: ${sql}`);
     },
   };
