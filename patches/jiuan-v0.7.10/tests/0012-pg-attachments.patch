+  const state = async id => (await pool.query('SELECT content_state, content_available FROM audit_attachments WHERE attachment_id = ?', [id]))[0][0];
+  const fetches = async id => (await pool.query('SELECT attempt_no, status FROM audit_attachment_fetches WHERE attachment_id = ? ORDER BY attempt_no', [id]))[0];
+
+  const queued = await store.enqueuePending({ now: at(0) });
+  assert.equal(queued.length, 2);
+  assert.deepEqual(queued.map(item => item.attemptNo), [1, 1]);
+  assert.deepEqual(await store.enqueuePending({ now: at(0) }), [], '已经排上的不再排');
+
+  // 第一个领走后失败、一小时后再试；第二个领走后租约过期，被收回
+  const first = await store.claimNext({ workerId: 'w1', leaseMs: 60_000, now: at(1) });
+  assert.equal((await state(first.attachment_id)).content_state, 'fetching');
+  const failed = await store.failFetch({ fetchId: first.fetch_id, attachmentId: first.attachment_id, workerId: 'w1', failureCode: 'HTTP_503', failureMessage: 'busy', retryAt: at(60), finishedAt: at(2) });
+  assert.deepEqual([failed.status, failed.nextAttempt], ['failed', 2]);
+  assert.deepEqual(await fetches(first.attachment_id), [{ attempt_no: 1, status: 'failed' }, { attempt_no: 2, status: 'queued' }]);
+  const second = await store.claimNext({ workerId: 'w2', leaseMs: 60_000, now: at(3) });
+  assert.notEqual(second.attachment_id, first.attachment_id, '还没到重试时间的不领');
+  assert.equal(await store.claimNext({ workerId: 'w3', leaseMs: 60_000, now: at(3) }), null);
+  assert.ok(await store.recoverExpired({ now: at(10) }) >= 1);
+  assert.deepEqual((await fetches(second.attachment_id)).map(row => row.status), ['queued']);
+  assert.equal((await state(second.attachment_id)).content_state, 'queued');
+
+  // 收回的那个再领、下载完成
+  const again = await store.claimNext({ workerId: 'w4', leaseMs: 60_000, now: at(11) });
+  assert.equal(again.attachment_id, second.attachment_id);
+  await store.completeFetch({ fetchId: again.fetch_id, attachmentId: again.attachment_id, workerId: 'w4', storageRef: 'aa/two.bin', sha256: sha('a'), receivedBytes: 12, retentionUntil: at(600), finishedAt: at(12) });
+  assert.deepEqual(await state(again.attachment_id), { content_state: 'downloaded', content_available: 1 });
+  await assert.rejects(store.completeFetch({ fetchId: again.fetch_id, attachmentId: again.attachment_id, workerId: 'w4', storageRef: 'aa/two.bin', sha256: sha('a'), receivedBytes: 12, finishedAt: at(13) }),
+    error => error.code === 'ANALYSIS_ATTACHMENT_LEASE', '同一个租约只能完成一次');
+
+  // 解析：排队（下载了、还没解析过的）→ 领取 → 完成；再直接记一次别的方法，记两遍是同一行
+  const extractions = await store.enqueuePendingExtractions({ method: 'text', parserVersion: 'p1', now: at(14) });
+  assert.deepEqual(extractions.map(item => item.attachment_id), [again.attachment_id]);
+  const job = await store.claimNextExtraction({ workerId: 'x1', leaseMs: 60_000, now: at(15) });
+  assert.equal(job.extraction_id, extractions[0].extractionId);
+  await store.completeExtraction({ extractionId: job.extraction_id, attachmentId: job.attachment_id, workerId: 'x1', contentSha256: sha('a'), method: 'text', parserVersion: 'p1', status: 'succeeded', pageCount: 1, coverageState: 'complete', text: '合成文字', finishedAt: at(16) });
+  for (let round = 0; round < 2; round += 1) {
+    await store.recordExtraction({ attachmentId: job.attachment_id, method: 'ocr', parserVersion: 'p2', contentSha256: sha('a'), status: 'succeeded', pageCount: 1, coverageState: 'complete', text: `第 ${round} 次`, finishedAt: at(17 + round) });
+  }
+  const [rows] = await pool.query('SELECT method, status FROM audit_attachment_extractions WHERE attachment_id = ? ORDER BY method', [job.attachment_id]);
+  assert.deepEqual(rows, [{ method: 'ocr', status: 'succeeded' }, { method: 'text', status: 'succeeded' }]);
+  assert.deepEqual(await store.enqueuePendingExtractions({ method: 'text', parserVersion: 'p1', now: at(20) }), []);
+
+  // 到期清理：只清下载了、过了保留期的
+  const expired = await store.expireDownloaded({ before: at(601) });
+  assert.deepEqual(expired.map(row => row.attachment_id), [again.attachment_id]);
+  assert.deepEqual(await state(again.attachment_id), { content_state: 'expired', content_available: 0 });
+});
