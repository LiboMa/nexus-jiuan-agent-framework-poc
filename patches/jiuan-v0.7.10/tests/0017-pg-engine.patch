-    'column REFERENCES': ['CREATE TABLE IF NOT EXISTS child (id INT PRIMARY KEY, parent_id INT REFERENCES parent (id))', /REFERENCES/],
-    'lower case, split over lines, extra spaces': ['create table if not exists child (\n  id int primary key,\n  parent_id int,\n  constraint fk_child\n    foreign    key (parent_id)\n    references\tparent (id)\n)', /FOREIGN KEY|REFERENCES/],
-    'AS SELECT': ['CREATE TABLE IF NOT EXISTS copy AS SELECT * FROM source', /SELECT/],
-    'as select over lines': ['create table if not exists copy\n  as\n  select id from source', /SELECT/],
-    'SELECT without AS': ['CREATE TABLE IF NOT EXISTS copy (id INT) SELECT id FROM source', /SELECT/],
-    'LIKE': ['CREATE TABLE IF NOT EXISTS copy LIKE source', /LIKE/],
-    'LIKE in parentheses': ['CREATE TABLE IF NOT EXISTS copy (LIKE source)', /LIKE/],
