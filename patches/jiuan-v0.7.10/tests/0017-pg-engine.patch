new file mode 100644
index 0000000..7335772
--- /dev/null
+++ b/tests/pg-runtime-graph.test.mjs
@@ -0,0 +1,87 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { existsSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs';
+import { dirname, join, resolve } from 'node:path';
+import { tmpdir } from 'node:os';
+import { fileURLToPath } from 'node:url';
+import { readAnalysisConfig } from '../src/analysis-config.mjs';
+import { analysisDatabaseEngine, createAnalysisDatabase } from '../src/analysis-database.mjs';
+
+// PostgreSQL 是唯一的库：测试台外壳加载的九安模块（poc/app/jiuan.mjs 里那张表）静态 import 一路走下去，
+// 没有一个碰 mysql2 或已删掉的 MySQL 模块；选引擎只认 postgres；配置照原来 MySQL 那条的规则校验。
+const ROOT = resolve(dirname(fileURLToPath(import.meta.url)), '..');
+const SHELL_ENTRIES = [
+  'analysis-server.mjs', 'src/analysis-auth.mjs', 'src/analysis-sync.mjs', 'src/platform/scheduler.mjs', 'src/platform/agent-runner.mjs',
+  'src/platform/adapters/list-sync.mjs', 'src/platform/adapters/report-detail.mjs', 'src/platform/adapters/detail-projection.mjs',
+  'src/platform/adapters/element-check.mjs', 'src/platform/agent-catalog.mjs', 'src/platform/adapters/catalog.mjs',
+  'src/analysis-config.mjs', 'src/huilianyi-source.mjs', 'src/analysis-runtime-services.mjs', 'src/analysis-runtime-registry.mjs',
+  'src/analysis-database.mjs', 'src/platform/platform-store.mjs', 'src/platform/connectors.mjs', 'providers/nexus-a2a.mjs',
+  'src/agent-contract/checks.mjs', 'src/agent-enablement.mjs', 'src/agent-task-service.mjs', 'src/agent-tasks/review-advice.mjs',
+  'src/agent-tasks/element-check-state.mjs', 'src/agent-tasks/review-advice-state.mjs', 'src/platform/service-identity.mjs',
+  'src/platform/call-middleware.mjs', 'src/platform/secret-source.mjs', 'src/platform/company-scope.mjs',
+  'src/platform/pipeline-progress.mjs', 'src/platform/platform-routes.mjs', 'src/company-directory.mjs',
+  'src/department-directory.mjs', 'src/approval-identity.mjs', 'src/milestone-runtime.mjs',
+];
+const MYSQL_MODULES = /(^|\/)mysql-(database|sync-database|sync-worker)\.mjs$/;
+
+/** Every module reachable from the entries by static import / export … from / import('literal'): { file → specifiers }. */
+function importGraph(entries) {
+  const seen = new Map(), queue = entries.map(entry => join(ROOT, entry));
+  while (queue.length) {
+    const file = queue.pop();
+    if (seen.has(file)) continue;
+    const source = readFileSync(file, 'utf8');
+    const specifiers = [...source.matchAll(/(?:^|[\s;])(?:import|export)\s[^'"`;]*?from\s*['"]([^'"]+)['"]|import\(\s*['"]([^'"]+)['"]\s*\)|^\s*import\s+['"]([^'"]+)['"]/gm)]
+      .map(match => match[1] || match[2] || match[3]);
+    seen.set(file, specifiers);
+    for (const specifier of specifiers) {
+      if (!specifier.startsWith('.')) continue;
+      const target = resolve(dirname(file), specifier);
+      assert.ok(existsSync(target), `${file.slice(ROOT.length + 1)} imports a missing module ${specifier}`);
+      queue.push(target);
+    }
+  }
+  return seen;
+}
+
+test('外壳加载的九安模块一路 import 下去：没有 mysql2，没有已删掉的 MySQL 模块，引用的文件都在', () => {
+  assert.equal(SHELL_ENTRIES.length, 35);
+  const graph = importGraph(SHELL_ENTRIES);
+  assert.ok(graph.size > SHELL_ENTRIES.length, `walked ${graph.size} modules`);
+  const offenders = [];
+  for (const [file, specifiers] of graph) {
+    for (const specifier of specifiers) if (specifier === 'mysql2' || specifier.startsWith('mysql2/') || MYSQL_MODULES.test(specifier)) offenders.push(`${file.slice(ROOT.length + 1)} → ${specifier}`);
+  }
+  assert.deepEqual(offenders, []);
+  for (const removed of ['src/mysql-database.mjs', 'src/mysql-sync-database.mjs', 'src/mysql-sync-worker.mjs']) assert.equal(existsSync(join(ROOT, removed)), false, `${removed} is gone`);
+  const pkg = JSON.parse(readFileSync(join(ROOT, 'package.json'), 'utf8'));
+  assert.equal(Object.hasOwn(pkg.dependencies || {}, 'mysql2'), false);
+  assert.equal(typeof pkg.dependencies?.pg, 'string');
+});
+
+test('选引擎：只认 postgres；mysql 报 ANALYSIS_DATABASE_ENGINE_UNSUPPORTED', () => {
+  assert.equal(analysisDatabaseEngine({ database: { engine: 'postgres' } }), 'postgres');
+  assert.equal(analysisDatabaseEngine({ database: { engine: 'mysql' } }), 'unsupported');
+  assert.throws(() => createAnalysisDatabase({ config: { database: { engine: 'mysql', host: 'db', port: 3306, database: 'jiuan', user: 'u' } }, secrets: { databasePassword: 'p' } }),
+    error => error.code === 'ANALYSIS_DATABASE_ENGINE_UNSUPPORTED' && /PostgreSQL/.test(error.message));
+});
+
+function configFile(t, database) {
+  const dir = mkdtempSync(join(tmpdir(), 'pg-config-'));
+  t.after(() => rmSync(dir, { recursive: true, force: true }));
+  const file = join(dir, 'analysis.json');
+  writeFileSync(file, JSON.stringify({ environment: 'prod', mode: 'read_only_analysis', connectionId: 'c', scope: { tenantId: 't', companyId: 'co' },
+    origin: 'http://127.0.0.1:4180', database, automaticSync: false, syncIntervalMs: 0, accounts: [], protectedSecrets: '', tokenFile: join(dir, 'token'), caFile: join(dir, 'ca') }));
+  return file;
+}
+
+test('配置：postgres 照原来 MySQL 那条的规则（主机、端口、库名、用户）；测试台的 127.0.0.1:5433 / jiuan / jiuan_app 可以；mysql 不行', t => {
+  const accepted = readAnalysisConfig(configFile(t, { engine: 'postgres', host: '127.0.0.1', port: 5433, database: 'jiuan', user: 'jiuan_app' }));
+  assert.deepEqual(accepted.database, { engine: 'postgres', host: '127.0.0.1', port: 5433, database: 'jiuan', user: 'jiuan_app' });
+  assert.equal(readAnalysisConfig(configFile(t, { host: '127.0.0.1', port: 5433, database: 'jiuan', user: 'jiuan_app' })).database.engine, 'postgres', '不写 engine 就是 postgres');
+  for (const bad of [{ engine: 'mysql', host: '127.0.0.1', port: 3306, database: 'jiuan', user: 'jiuan_app' }, { engine: 'postgres', host: 'bad host', port: 5433, database: 'jiuan', user: 'u' },
+    { engine: 'postgres', host: '127.0.0.1', port: 0, database: 'jiuan', user: 'u' }, { engine: 'postgres', host: '127.0.0.1', port: 5433, database: 'bad name', user: 'u' },
+    { engine: 'postgres', host: '127.0.0.1', port: 5433, database: 'jiuan', user: '' }]) {
+    assert.throws(() => readAnalysisConfig(configFile(t, bad)), JSON.stringify(bad));
+  }
+});
