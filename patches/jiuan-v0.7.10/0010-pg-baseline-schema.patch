@@ -0,0 +1,1539 @@
+/**
+ * Jiuan's analysis database on PostgreSQL: one baseline migration (version 19) that creates the structure MySQL had after its
+ * migrations 1–19 — 70 tables (schema_migrations, the 71st, is created by migratePg itself), their indexes, foreign keys and
+ * CHECKs. Translated mechanically from `mysqldump --no-data` of the bench database, then reviewed. Type mapping:
+ *   varchar(n) / char(n) → varchar(n); int → integer; int unsigned / bigint unsigned → bigint CHECK (>= 0);
+ *   tinyint(1) / tinyint → smallint (MySQL never limited them to 0/1, so neither does this); tinyint unsigned → smallint CHECK (>= 0);
+ *   smallint unsigned → integer CHECK (>= 0); decimal → numeric; datetime(n) → timestamp(n); json → jsonb; blob → bytea; text → text;
+ *   DEFAULT CURRENT_TIMESTAMP(n) → DEFAULT LOCALTIMESTAMP(n) (the session zone is Asia/Shanghai, so the value is what MySQL wrote);
+ *   AUTO_INCREMENT → GENERATED BY DEFAULT AS IDENTITY; KEY → CREATE INDEX; UNIQUE KEY → a named UNIQUE constraint.
+ * ON UPDATE CURRENT_TIMESTAMP (ten updated_at columns) is a BEFORE UPDATE trigger on jiuan_touch_updated_at(): when another
+ * column really changed and updated_at was not set to a different value, updated_at becomes the current Shanghai wall time.
+ * Tables with more than one unique key (ON CONFLICT needs the right one named): see the patch description.
+ */
+export const PG_BASELINE_SCHEMA = `
+CREATE OR REPLACE FUNCTION jiuan_touch_updated_at() RETURNS trigger LANGUAGE plpgsql AS $touch$
+BEGIN
+  IF NEW.updated_at IS NOT DISTINCT FROM OLD.updated_at AND NEW IS DISTINCT FROM OLD THEN
+    NEW.updated_at := LOCALTIMESTAMP;
+  END IF;
+  RETURN NEW;
+END
+$touch$;
+
+CREATE TABLE "analysis_batches" (
+  "connection_id" varchar(191) NOT NULL,
+  "id" varchar(191) NOT NULL,
+  "tenant_id" varchar(191) NOT NULL,
+  "company_id" varchar(191) NOT NULL,
+  "status" varchar(32) NOT NULL,
+  "started_at" timestamp(6) NOT NULL,
+  "finished_at" timestamp(6) DEFAULT NULL,
+  "pages" bigint NOT NULL DEFAULT '0' CHECK ("pages" >= 0),
+  "report_count" bigint NOT NULL DEFAULT '0' CHECK ("report_count" >= 0),
+  "request_count" bigint NOT NULL DEFAULT '0' CHECK ("request_count" >= 0),
+  "query_payload" bytea NOT NULL,
+  "coverage_payload" bytea,
+  "message" varchar(1000) NOT NULL DEFAULT '',
+  "error_code" varchar(100) DEFAULT NULL,
+  PRIMARY KEY ("connection_id","id")
+);
+
+CREATE TABLE "analysis_connections" (
+  "connection_id" varchar(191) NOT NULL,
+  "environment" varchar(16) NOT NULL,
+  "schema_version" bigint NOT NULL CHECK ("schema_version" >= 0),
+  "key_check" bytea NOT NULL,
+  "tenant_id" varchar(191) DEFAULT NULL,
+  "created_at" timestamp(6) NOT NULL DEFAULT LOCALTIMESTAMP(6),
+  "updated_at" timestamp(6) NOT NULL DEFAULT LOCALTIMESTAMP(6),
+  PRIMARY KEY ("connection_id"),
+  CONSTRAINT "analysis_connections_environment" CHECK (("environment" = 'prod'))
+);
+
+CREATE TABLE "analysis_document_search" (
+  "connection_id" varchar(191) NOT NULL,
+  "document_id" varchar(191) NOT NULL,
+  "document_version" varchar(191) NOT NULL,
+  "payee_name" varchar(300) DEFAULT NULL,
+  "applicant_name" varchar(300) DEFAULT NULL,
+  PRIMARY KEY ("connection_id","document_id")
+);
+
+CREATE TABLE "analysis_document_versions" (
+  "connection_id" varchar(191) NOT NULL,
+  "document_id" varchar(191) NOT NULL,
+  "version" varchar(191) NOT NULL,
+  "modified_at" timestamp(6) DEFAULT NULL,
+  "collected_at" timestamp(6) NOT NULL,
