+  "connector_id" varchar(32) NOT NULL,
+  "agent_id" varchar(64) NOT NULL,
+  "limit_calls" bigint NOT NULL CHECK ("limit_calls" >= 0),
+  "used_calls" bigint NOT NULL DEFAULT '0' CHECK ("used_calls" >= 0),
+  "limit_tokens" bigint DEFAULT NULL CHECK ("limit_tokens" >= 0),
+  "used_tokens" bigint NOT NULL DEFAULT '0' CHECK ("used_tokens" >= 0),
+  PRIMARY KEY ("budget_day","connector_id","agent_id")
