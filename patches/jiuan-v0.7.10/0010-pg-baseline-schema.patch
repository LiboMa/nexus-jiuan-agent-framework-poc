+  CONSTRAINT "element_family_versions_chk_company_scope" CHECK (((("scope" <> 'company') or ("company_id" is not null)) and (("scope" <> 'group') or ("company_id" is null)))),
+  CONSTRAINT "element_family_versions_chk_confirmed" CHECK ((("status" not in ('effective','superseded','retired','applied')) or (("confirmer_account_id" is not null) and ("confirmer_principal" is not null) and ("confirmed_at" is not null)))),
+  CONSTRAINT "element_family_versions_chk_confirmer_differs" CHECK ((("activation_mode" = 'publish') or ("confirmer_principal" is null) or ("confirmer_principal" <> "submitter_principal"))),
+  CONSTRAINT "element_family_versions_chk_confirmer_dingtalk" CHECK ((("confirmer_principal" is null) or ("confirmer_principal" like 'dingtalk:%'))),
+  CONSTRAINT "element_family_versions_chk_format" CHECK (((("family_kind" <> 'agent') or ("definition_format" in ('expense-agent-def-v1','expense-agent-def-v2'))) and (("family_kind" <> 'parameter') or ("definition_format" = 'element-parameter-table-v1')) and (("family_kind" <> 'resolver') or ("definition_format" = 'element-resolver-table-v1')))),
+  CONSTRAINT "element_family_versions_chk_kind" CHECK (("family_kind" in ('agent','parameter','resolver'))),
+  CONSTRAINT "element_family_versions_chk_publisher" CHECK ((("activation_mode" <> 'publish') or ("confirmer_principal" is null) or (("confirmer_principal" = "submitter_principal") and ("confirmer_account_id" = "submitter_account_id")))),
+  CONSTRAINT "element_family_versions_chk_scope" CHECK (("scope" in ('group','company'))),
+  CONSTRAINT "element_family_versions_chk_status" CHECK (("status" in ('pending','returned','withdrawn','effective','superseded','retired','applied'))),
