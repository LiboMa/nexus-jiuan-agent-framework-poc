+CREATE TABLE "platform_call_log" (
+  "call_id" bigint GENERATED BY DEFAULT AS IDENTITY NOT NULL CHECK ("call_id" >= 0),
+  "connector_id" varchar(32) NOT NULL,
+  "operation" varchar(96) NOT NULL,
+  "agent_id" varchar(64) NOT NULL,
+  "run_id" varchar(26) DEFAULT NULL,
+  "attempt_no" smallint NOT NULL CHECK ("attempt_no" >= 0),
+  "started_at" timestamp(6) NOT NULL,
+  "duration_ms" bigint NOT NULL CHECK ("duration_ms" >= 0),
+  "outcome" varchar(24) NOT NULL,
+  "http_status" integer DEFAULT NULL CHECK ("http_status" >= 0),
+  "error_code" varchar(64) DEFAULT NULL,
+  "response_bytes" bigint DEFAULT NULL CHECK ("response_bytes" >= 0),
+  "input_tokens" bigint DEFAULT NULL CHECK ("input_tokens" >= 0),
+  "output_tokens" bigint DEFAULT NULL CHECK ("output_tokens" >= 0),
+  "process_tag" varchar(64) NOT NULL,
+  PRIMARY KEY ("call_id"),
+  CONSTRAINT "platform_call_log_outcome" CHECK (("outcome" in ('ok','error','retryable_error','timeout','rejected_budget','rejected_paused','rejected_not_allowed','rejected_breaker','rejected_unattributed')))
+);
+
+CREATE TABLE "platform_change_log" (
+  "change_id" bigint GENERATED BY DEFAULT AS IDENTITY NOT NULL CHECK ("change_id" >= 0),
+  "event_kind" varchar(16) NOT NULL,
+  "scope_kind" varchar(16) NOT NULL,
+  "scope_id" varchar(64) NOT NULL,
+  "from_revision" bigint DEFAULT NULL CHECK ("from_revision" >= 0),
+  "to_revision" bigint DEFAULT NULL CHECK ("to_revision" >= 0),
+  "actor_principal" varchar(191) NOT NULL,
+  "actor_role" varchar(32) NOT NULL,
+  "occurred_at" timestamp(6) NOT NULL,
+  "reason" varchar(400) DEFAULT NULL,
+  "before_json" jsonb DEFAULT NULL,
+  "after_json" jsonb DEFAULT NULL,
+  "operation_json" jsonb DEFAULT NULL,
+  "result_json" jsonb DEFAULT NULL,
+  "outcome" varchar(16) NOT NULL,
+  "run_id" varchar(26) DEFAULT NULL,
+  PRIMARY KEY ("change_id"),
+  CONSTRAINT "platform_change_log_event" CHECK (("event_kind" in ('config_change','operation','auth','access_denied'))),
+  CONSTRAINT "platform_change_log_outcome" CHECK (("outcome" in ('ok','refused','failed')))
+);
+
+CREATE TABLE "platform_settings" (
+  "scope_kind" varchar(16) NOT NULL,
