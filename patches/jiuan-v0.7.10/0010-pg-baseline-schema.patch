+  "draft_revision" bigint NOT NULL CHECK ("draft_revision" >= 0),
+  "action" varchar(24) NOT NULL,
+  "element_id" varchar(191) DEFAULT NULL,
+  "intent" varchar(24) DEFAULT NULL,
+  "note_ciphertext" bytea,
+  "actor_account_id" varchar(191) NOT NULL,
+  "actor_mode" varchar(16) NOT NULL,
+  "actor_principal" varchar(191) NOT NULL,
+  "at" timestamp(6) NOT NULL,
+  "draft_hash" varchar(64) NOT NULL,
+  "source_version_id" varchar(36) DEFAULT NULL,
+  PRIMARY KEY ("edit_id"),
+  CONSTRAINT "element_draft_edits_revision" UNIQUE ("connection_id","family_id","draft_revision"),
+  CONSTRAINT "element_draft_edits_chk_action" CHECK (("action" in ('adopt','add','modify','discard','restore','resolve_conflict','import','save'))),
+  CONSTRAINT "element_draft_edits_chk_actor" CHECK (((("actor_mode" = 'dingtalk') and ("actor_principal" like 'dingtalk:%')) or (("actor_mode" = 'local') and ("actor_principal" like 'local:%')))),
+  CONSTRAINT "element_draft_edits_chk_intent" CHECK ((("intent" is null) or ("intent" in ('void_draft','abandon_changes','restore_draft','restart_from_effective','restore_version')))),
+  CONSTRAINT "element_draft_edits_chk_intent_pair" CHECK ((("intent" is null) or ((("intent" not in ('void_draft','abandon_changes')) or (("action" = 'discard') and ("element_id" is null))) and (("intent" <> 'restore_draft') or (("action" = 'restore') and ("element_id" is null))) and (("intent" not in ('restart_from_effective','restore_version')) or (("action" = 'save') and ("element_id" is null)))))),
+  CONSTRAINT "element_draft_edits_chk_source_version" CHECK (((coalesce("intent",'') = 'restore_version') = ("source_version_id" is not null))),
+  CONSTRAINT "element_draft_edits_chk_whole_mark" CHECK ((("element_id" is not null) or ("action" not in ('discard','restore')) or ("intent" is not null)))
+);
