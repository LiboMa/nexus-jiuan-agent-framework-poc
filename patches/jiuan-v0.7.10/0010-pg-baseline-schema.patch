+/**
+ * Migrations. PostgreSQL starts from one baseline (version 19, the structure MySQL had after its migrations 1–19); later ones
+ * are numbered from 20. schema_migrations has the columns the MySQL table had, so the platform's version view reads it as before.
+ */
+export const PG_MIGRATIONS = Object.freeze([Object.freeze({ version: 19, name: 'postgres-baseline', sql: PG_BASELINE_SCHEMA })]);
+const SCHEMA_LOCK = 'jiuan:pg:schema';
+const SCHEMA_MIGRATIONS_DDL = `CREATE TABLE IF NOT EXISTS schema_migrations (
+  version bigint NOT NULL CHECK (version >= 0),
+  name varchar(191) NOT NULL,
+  applied_at timestamp(6) NOT NULL DEFAULT LOCALTIMESTAMP(6),
+  checksum varchar(64) DEFAULT NULL,
+  adopted_by varchar(32) DEFAULT NULL,
+  additive smallint DEFAULT NULL,
+  PRIMARY KEY (version)
+)`;
+
+export function migrationChecksum(migration) {
+  const normalized = String(migration?.sql ?? '').replaceAll('\r\n', '\n').trim();
+  return createHash('sha256').update(normalized, 'utf8').digest('hex');
+}
+
+/**
+ * The versions in schema_migrations against the migrations this program knows: applied (normal), not yet applied (pending),
+ * newer than this program but marked additive (aheadAdditive: only new tables, this program still runs), anything else (drift).
+ */
+export function classifyMigrationVersions(appliedRecords = [], knownMigrations = PG_MIGRATIONS) {
+  const ordered = [...(knownMigrations || [])].sort((a, b) => a.version - b.version);
+  const highestKnownVersion = Math.max(0, ...ordered.map(item => Number(item.version)));
+  const records = appliedRecords instanceof Map
+    ? appliedRecords
+    : new Map((appliedRecords || []).map(record => [Number(record?.version), record]));
+  const normal = [];
+  const pending = [];
+  for (const migration of ordered) (records.has(Number(migration.version)) ? normal : pending).push(Number(migration.version));
+  const aheadAdditive = [];
+  const drift = [];
+  for (const [version, record] of records) {
+    const numericVersion = Number(version);
+    if (ordered.some(item => Number(item.version) === numericVersion)) continue;
+    if (numericVersion > highestKnownVersion && Number(record?.additive) === 1) aheadAdditive.push(numericVersion);
+    else drift.push({ version: numericVersion, reason: 'unknown_version' });
+  }
+  aheadAdditive.sort((a, b) => a - b);
+  drift.sort((a, b) => a.version - b.version);
+  return { normal, pending, aheadAdditive, drift, highestKnownVersion };
+}
+
+/**
+ * Additive means the previous image keeps working on the migrated database: only new tables, without a foreign key (the old
+ * image could no longer delete the rows they point to) and not copied from another table (AS SELECT, LIKE).
+ */
+export function validateAdditiveMigration(migration) {
+  if (migration?.additive !== true) return;
+  const label = `Migration ${migration.version} (${migration.name}) marked additive`;
+  const statements = splitSqlStatements(String(migration.sql || '')).map(codeOnly);
+  if (!statements.length || statements.some(statement => !/^CREATE\s+TABLE\s+IF\s+NOT\s+EXISTS\b/i.test(statement))) {
+    throw configuration(`${label} must contain only CREATE TABLE IF NOT EXISTS statements.`);
+  }
+  for (const code of statements) {
+    if (/\bFOREIGN\s+KEY\b|\bREFERENCES\b/i.test(code)) throw configuration(`${label} must not declare a FOREIGN KEY or REFERENCES: the previous image could no longer delete the rows it points to.`);
+    if (/\bSELECT\b/i.test(code)) throw configuration(`${label} must not create a table from a SELECT (CREATE TABLE ... AS SELECT).`);
+    if (/^CREATE\s+TABLE\s+IF\s+NOT\s+EXISTS\s+(?:\S+\s*)?\(?\s*LIKE\b/i.test(code)) throw configuration(`${label} must not copy another table (CREATE TABLE ... LIKE).`);
+  }
+}
+
+function orderedMigrations(migrations) {
+  if (!Array.isArray(migrations) || !migrations.length || migrations.some(item => !Number.isInteger(item?.version) || item.version < 1 || typeof item.name !== 'string' || !item.name || typeof item.sql !== 'string' || !item.sql.trim())) throw configuration('PostgreSQL migrations are invalid.');
+  const ordered = [...migrations].sort((a, b) => a.version - b.version);
+  if (new Set(ordered.map(item => item.version)).size !== ordered.length) throw configuration('PostgreSQL migrations contain duplicate versions.');
+  for (const migration of ordered) validateAdditiveMigration(migration);
+  return ordered;
+}
+
+/**
+ * What the structure should be: the migrations run in a scratch schema inside a transaction that is rolled back, then listed.
+ * Built from the DDL itself each time, so the expectation cannot drift from it. Runs on a connection with no open transaction.
+ */
+async function expectedEntries(conn, migrations) {
+  const scratch = `jiuan_expected_${randomBytes(6).toString('hex')}`;
+  await conn.beginTransaction();
+  try {
+    await conn.query(`CREATE SCHEMA ${scratch}`);
+    await conn.query(`SET LOCAL search_path = ${scratch}`);
+    await conn.query(SCHEMA_MIGRATIONS_DDL);
+    for (const migration of migrations) for (const statement of splitSqlStatements(migration.sql)) await conn.query(statement);
+    return await schemaListingEntries(conn, scratch);
+  } finally {
+    await conn.rollback();
+  }
+}
+
+/** The structure listing the migrations produce (text, as readSchemaListing gives it for a database they ran on). */
+export async function expectedSchemaListing(conn, migrations = PG_MIGRATIONS) {
+  return (await expectedEntries(conn, orderedMigrations(migrations))).map(entry => entry.text).join('\n');
+}
+
+/** Live structure against the expected one, over the tables the migrations own (the shell's own tables do not count). */
+async function compareSchema(conn, migrations) {
+  const expected = await expectedEntries(conn, migrations);
+  const owners = new Set(expected.map(entry => entry.owner));
+  const live = (await schemaListingEntries(conn)).filter(entry => owners.has(entry.owner));
+  const want = new Set(expected.map(entry => entry.text));
+  const have = new Set(live.map(entry => entry.text));
+  return { missing: [...want].filter(text => !have.has(text)), unexpected: [...have].filter(text => !want.has(text)) };
+}
+
+function migrationDriftError(drift) {
+  const first = (label, items) => (items?.length ? ` ${label}: ${items.slice(0, 5).join(' | ')}${items.length > 5 ? ` (+${items.length - 5} more)` : ''}` : '');
+  const summary = drift.map(item => `v${item.version} ${item.reason}${first('missing', item.missing)}${first('unexpected', item.unexpected)}`).join('; ');
+  return Object.assign(new Error(`PostgreSQL migration drift detected: ${summary}`), { code: PG_ERROR_CODES.MIGRATION_DRIFT, drift });
+}
+
+/**
+ * Brings the database to the known migrations under the schema lock: creates schema_migrations, checks what was applied before
+ * (checksum and structure; a difference is PG_MIGRATION_DRIFT and nothing is changed), then runs each pending migration in its
+ * own transaction and records it. Returns { applied, currentVersion, aheadAdditive }.
+ */
+export async function migratePg(pool, { migrations = PG_MIGRATIONS, lockName = SCHEMA_LOCK, lockTimeout = 30 } = {}) {
+  if (!pool || typeof pool.getConnection !== 'function') throw configuration('A PostgreSQL pool is required.');
+  const ordered = orderedMigrations(migrations);
+  const connection = await pool.getConnection();
+  let locked = false;
+  try {
+    if (!(await acquireNamedLock(connection, lockName, lockTimeout))) throw Object.assign(new Error('Unable to acquire PostgreSQL migration lock.'), { code: PG_ERROR_CODES.MIGRATION_LOCKED });
+    locked = true;
+    await connection.query(SCHEMA_MIGRATIONS_DDL);
+    const [rows] = await connection.query('SELECT version, name, checksum, adopted_by, additive FROM schema_migrations ORDER BY version');
+    const records = new Map(rows.map(row => [Number(row.version), row]));
+    const classification = classifyMigrationVersions(records, ordered);
+    for (const version of classification.aheadAdditive) console.log(`PG_SCHEMA_AHEAD_ADDITIVE v${version}`);
+    const drift = [...classification.drift];
+    const appliedKnown = ordered.filter(migration => records.has(migration.version));
+    const adoptions = [];
+    for (const migration of appliedKnown) {
+      const checksum = records.get(migration.version).checksum;
+      if (checksum == null) adoptions.push(migration);
+      else if (String(checksum) !== migrationChecksum(migration)) drift.push({ version: migration.version, name: migration.name, reason: 'checksum_changed' });
+    }
+    if (appliedKnown.length) {
+      const { missing, unexpected } = await compareSchema(connection, appliedKnown);
+      if (missing.length || unexpected.length) drift.push({ version: appliedKnown.at(-1).version, name: appliedKnown.at(-1).name, reason: 'schema_differs', missing, unexpected });
+    }
+    if (drift.length) throw migrationDriftError(drift);
+    for (const migration of adoptions) {
+      await connection.query('UPDATE schema_migrations SET checksum = ?, adopted_by = ? WHERE version = ?', [migrationChecksum(migration), 'readback', migration.version]);
+    }
+    const applied = [];
+    for (const migration of ordered) {
+      if (records.has(migration.version)) continue;
+      await connection.beginTransaction();
+      try {
+        for (const statement of splitSqlStatements(migration.sql)) await connection.query(statement);
+        await connection.query('INSERT INTO schema_migrations (version, name, checksum, adopted_by, additive) VALUES (?, ?, ?, ?, ?)', [migration.version, migration.name, migrationChecksum(migration), 'applied', migration.additive === true ? 1 : 0]);
+        await connection.commit();
+      } catch (error) {
+        try { await connection.rollback(); } catch { /* the error that matters is the migration's */ }
+        throw error;
+      }
+      applied.push(migration.version);
+    }
+    return { applied, currentVersion: Math.max(0, ...ordered.map(item => item.version), ...records.keys()), aheadAdditive: classification.aheadAdditive };
+  } finally {
+    if (locked) { try { await releaseNamedLock(connection, lockName); } catch { /* release is best effort; the lock goes with the connection */ } }
+    connection.release();
+  }
+}
+
+export async function pgHealth(pool) {
+  if (!pool || typeof pool.query !== 'function') throw configuration('A PostgreSQL pool is required.');
+  const [rows] = await pool.query('SELECT 1 AS ok');
+  return Number(rows?.[0]?.ok) === 1;
+}
+
