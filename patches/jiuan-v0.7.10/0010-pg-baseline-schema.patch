+const OWNERLESS = 'function';
+
+/**
+ * The structure of one schema as sorted lines, one per table, column (type, nullability, default, identity), index, constraint,
+ * trigger and function (by the md5 of its body). Schema names are taken out of the definitions, so two schemas built from the
+ * same DDL list the same. Each entry has the table (or "function <name>") it belongs to, for filtering.
+ */
+export async function schemaListingEntries(conn, schema) {
+  const name = schema ?? (await conn.query('SELECT current_schema() AS name'))[0][0].name;
+  const qualifier = new RegExp(`(?<![A-Za-z0-9_"])"?${name.replace(/[^A-Za-z0-9_]/g, '')}"?\\.`, 'g');
+  const bare = text => String(text ?? '').replace(qualifier, '');
+  const query = async sql => (await conn.query(sql, [name]))[0];
+  const entries = [];
+  const add = (owner, text) => entries.push({ owner, text });
+  for (const row of await query("SELECT c.relname AS tbl FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace WHERE n.nspname = ? AND c.relkind IN ('r', 'p')")) {
+    add(row.tbl, `table ${row.tbl}`);
+  }
+  for (const row of await query(`SELECT c.relname AS tbl, a.attname AS col, format_type(a.atttypid, a.atttypmod) AS type, a.attnotnull AS not_null,
+      pg_get_expr(d.adbin, d.adrelid) AS dflt, a.attidentity AS ident, a.attgenerated AS gen
+    FROM pg_attribute a JOIN pg_class c ON c.oid = a.attrelid JOIN pg_namespace n ON n.oid = c.relnamespace
+    LEFT JOIN pg_attrdef d ON d.adrelid = a.attrelid AND d.adnum = a.attnum
+    WHERE n.nspname = ? AND c.relkind IN ('r', 'p') AND a.attnum > 0 AND NOT a.attisdropped`)) {
+    add(row.tbl, `column ${row.tbl}.${row.col} ${row.type}${row.not_null ? ' not null' : ''}${row.dflt ? ` default ${bare(row.dflt)}` : ''}${row.ident ? ` identity ${row.ident}` : ''}${row.gen ? ` generated ${row.gen}` : ''}`);
+  }
+  for (const row of await query(`SELECT t.relname AS tbl, i.relname AS name, pg_get_indexdef(i.oid) AS def
+    FROM pg_index x JOIN pg_class i ON i.oid = x.indexrelid JOIN pg_class t ON t.oid = x.indrelid JOIN pg_namespace n ON n.oid = t.relnamespace
+    WHERE n.nspname = ?`)) {
+    add(row.tbl, `index ${row.tbl}.${row.name} ${bare(row.def)}`);
+  }
+  for (const row of await query(`SELECT t.relname AS tbl, k.conname AS name, pg_get_constraintdef(k.oid) AS def
+    FROM pg_constraint k JOIN pg_class t ON t.oid = k.conrelid JOIN pg_namespace n ON n.oid = t.relnamespace
+    WHERE n.nspname = ? AND k.contype IN ('c', 'f', 'p', 'u', 'x')`)) {
+    add(row.tbl, `constraint ${row.tbl}.${row.name} ${bare(row.def)}`);
+  }
+  for (const row of await query(`SELECT t.relname AS tbl, g.tgname AS name, pg_get_triggerdef(g.oid) AS def
+    FROM pg_trigger g JOIN pg_class t ON t.oid = g.tgrelid JOIN pg_namespace n ON n.oid = t.relnamespace
+    WHERE n.nspname = ? AND NOT g.tgisinternal`)) {
+    add(row.tbl, `trigger ${row.tbl}.${row.name} ${bare(row.def)}`);
+  }
+  for (const row of await query(`SELECT p.proname AS name, pg_get_function_identity_arguments(p.oid) AS args, md5(p.prosrc) AS body
+    FROM pg_proc p JOIN pg_namespace n ON n.oid = p.pronamespace WHERE n.nspname = ?`)) {
+    add(`${OWNERLESS} ${row.name}`, `function ${row.name}(${bare(row.args)}) ${row.body}`);
+  }
+  return entries.sort((a, b) => (a.text < b.text ? -1 : a.text > b.text ? 1 : 0));
+}
+
+/** The structure listing of a schema (the current one by default) as text, one sorted line per object. */
+export async function readSchemaListing(conn, { schema } = {}) {
+  return (await schemaListingEntries(conn, schema)).map(entry => entry.text).join('\n');
+}
