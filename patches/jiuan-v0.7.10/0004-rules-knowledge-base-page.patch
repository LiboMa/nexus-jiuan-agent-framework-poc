+.kb-page{gap:12px}
+.kb-page .platform-ops-card{display:flex;flex-direction:column;gap:10px}
+.kb-lede{margin:-4px 0 0;max-width:72ch;color:var(--ui-muted);font-size:13px;line-height:1.7}
+.kb-drop{display:flex;flex-wrap:wrap;align-items:center;gap:8px 12px;padding:18px;border:1px dashed #bfdcf7;border-radius:10px;background:var(--ui-soft);color:#374151;font-size:13px;transition:border-color var(--ui-fast) var(--ui-ease),background var(--ui-fast) var(--ui-ease)}
+.kb-drop.dragging{border-color:var(--ui-accent);background:#e6f1ff}
+.kb-muted{margin:0;color:var(--ui-muted);font-size:12px;line-height:1.7}
+.kb-report{display:flex;flex-direction:column;gap:8px}
+.kb-report>strong{color:var(--ui-ink);font-size:14px}
+.kb-fields{display:flex;flex-wrap:wrap;gap:10px 14px}
+.kb-field{display:flex;flex-direction:column;gap:4px;min-width:220px;flex:1 1 220px;color:#4b5563;font-size:12px}
+.kb-page input[type="text"]{box-sizing:border-box;min-height:36px;padding:7px 10px;border:1px solid var(--ui-line);border-radius:8px;background:#fff;color:#374151;font:inherit;font-size:13px}
+.kb-page input[type="text"]:focus{border-color:var(--ui-accent);outline:none;box-shadow:0 0 0 3px var(--ui-soft-line)}
+.kb-preview{margin:0;padding:8px 12px;border-radius:8px;background:var(--ui-bg);color:#374151;font-size:13px}
+.kb-warn{margin:0;padding:8px 12px;border:1px solid #fcd34d;border-radius:8px;background:#fffbeb;color:#92400e;font-size:13px;line-height:1.6}
+.kb-warn.kb-block{border-color:#fca5a5;background:#fef2f2;color:#991b1b}
+.kb-actions{display:flex;flex-wrap:wrap;gap:8px}
+.kb-search{display:flex;flex-wrap:wrap;gap:8px}
+.kb-search input[type="text"]{flex:1 1 320px}
+.kb-section-head{display:flex;align-items:center;justify-content:space-between;gap:10px}
+.kb-section-head h2{margin:0}
+.kb-detail{display:flex;flex-direction:column;gap:8px;padding:12px 14px;border:1px solid var(--ui-line);border-left:3px solid var(--ui-accent);border-radius:10px;background:#fff}
+@media(prefers-reduced-motion:reduce){.kb-drop{transition:none}}
