# =============================================================================
# pgvector-rules-kb 部署配置
#
#   cp deploy.env.example deploy.env    # deploy.env 已被 .gitignore 忽略，不会进仓库
#   vi deploy.env                        # 只改本文件即可完成一次部署
#   ./deploy.sh preflight                # 先做只读预检
#   ./deploy.sh all                      # 一键部署（幂等，可重复执行）
#
# 格式：bash 的 KEY=VALUE（会被 source）。值里有空格或中文括号时用双引号括起来。
# 值里的 <…> 是占位符（样例里带着引号），整个换成真实值；还留着时 deploy.sh 会指出是哪一项。
# 留空的项按注释里的规则自动发现或取默认值。各项的完整说明见 GUIDE.md「3. 配置参考」。
# 不要把任何密码写进本文件。
# =============================================================================

# ---- 1. 基本 -----------------------------------------------------------------
# 本次部署的名字：用于状态文件 .state/<DEPLOY_NAME>.env、CloudFormation 栈名前缀、资源标签。
# 同一套 Nexus 上部署多份（例如测试副本）时，每份用不同的名字。
DEPLOY_NAME=pgvector-rules-kb
AWS_REGION=us-east-1
# 留空则用默认凭证链（环境变量 / ~/.aws/config 的 default）。
AWS_PROFILE=

# ---- 2. Nexus ----------------------------------------------------------------
# Nexus 前端地址（不带结尾的 /），例如 https://<env>.<your-domain>
NEXUS_URL='https://<env>.<your-domain>'
# Sandbox 节点的 nexus:environment 标签值，形如 <env>-<id>（在 EC2 控制台看 Sandbox 节点的标签）。
# 用于 verify 阶段登录 Sandbox 节点核对 nftables 白名单；留空则跳过这项核对。
NEXUS_ENV_ID=
NEXUS_ADMIN_USER=admin
# 管理员密码来源，三选一（按顺序取第一个有值的）：
#   1) 运行时环境变量 NEXUS_ADMIN_PASSWORD（不要写进本文件）
#   2) NEXUS_ADMIN_PASSWORD_FILE：本地文件路径，文件内容就是密码（建议 chmod 600）
#   3) NEXUS_ADMIN_PASSWORD_SSM：<deployer 实例 ID>:<deploy.yaml 绝对路径>，经 SSM 读取其中的 auth_password
#      （仅当 admin 密码从未在界面上改过时有效）
NEXUS_ADMIN_PASSWORD_FILE=
NEXUS_ADMIN_PASSWORD_SSM=

# ---- 3. PG 主机 --------------------------------------------------------------
# existing：装到一台已有的 EC2 上（SSM 在线或能 SSH 登录、Linux、与 Nexus 同 VPC 或私网可达）
# create  ：用 CloudFormation 新建一台专用 EC2（cfn/pgvector-host.yaml；只经 SSM）
PG_HOST_MODE=existing
# existing 模式必填：目标实例 ID（i-xxxxxxxx）。
PG_HOST_INSTANCE_ID=
# 怎么登上 PG 主机：ssm（缺省，经 SSM Run Command 和 SSM 端口转发）或 ssh（只用于 existing 模式，用部署人自己的 SSH 密钥）。
PG_HOST_TRANSPORT=ssm
# PG_HOST_TRANSPORT=ssh 时：主机地址（本机能 SSH 到的公网或私网地址）、本机私钥的绝对路径（权限 600）、登录用户（要能免密 sudo）、端口。
PG_SSH_HOST=
PG_SSH_KEY=
PG_SSH_USER=ec2-user
PG_SSH_PORT=22
# 核对过的 known_hosts 文件（主机公钥）：给了就严格核对；留空 = 第一次连时信任并记进 .state/<DEPLOY_NAME>.known_hosts，之后照它核对。
PG_SSH_KNOWN_HOSTS=
# 本机连不到 PG_SSH_HOST 时的 ssh ProxyCommand（一行）：跳板机，或 EC2 Instance Connect 端点
# （'aws ec2-instance-connect open-tunnel --region <区域> --instance-id <实例>'）。留空 = 直连。
PG_SSH_PROXY_COMMAND=
# create 模式必填：Nexus VPC 里的一个私有子网（须有 NAT 出网，用于拉取镜像）。
PG_CREATE_SUBNET_ID=
PG_CREATE_INSTANCE_TYPE=t3.medium
PG_CREATE_VOLUME_GB=30

# ---- 4. PG 容器 --------------------------------------------------------------
PG_IMAGE=pgvector/pgvector:pg17
PG_CONTAINER_NAME=nexus-pgvector
PG_PORT=5432
# 容器端口绑定到的主机地址；留空 = 目标主机的私网 IP（推荐，避免绑到 0.0.0.0）。
PG_BIND_IP=
PG_DATA_VOLUME=nexus-pgvector-data
PG_MEMORY_LIMIT=2g
# 主机上的工作目录：其中 .env（权限 600）保存自动生成的数据库密码。
PG_BASE_DIR=/opt/nexus-pgvector
PG_DB_NAME=nexus
PG_DB_USER=nexus
# 目标主机没有 Docker 时是否自动安装（dnf/yum）。
PG_INSTALL_DOCKER=true

# ---- 5. 网络 -----------------------------------------------------------------
# 放行访问 PG_PORT 的来源网段（安全组入站规则）；留空 = 目标主机所在 VPC 的 CIDR。只放私网段。
PG_ALLOWED_CIDR=
# 写入 Nexus 配置 nexus_ai.sandbox.network.vm_egress.allow_cidrs（与现值合并，不会删已有项）。
# Sandbox VM 默认丢弃所有私网目标；不放行这里，VM 里的 Agent 连不上 PG。
# 留空 = 最小放行 <PG 主机私网 IP>/32（推荐）。参考环境按要求放的是 10.0.0.0/8。多个用英文逗号分隔。
VM_EGRESS_ALLOW_CIDRS=

# ---- 6. Nexus 数据连接器 ------------------------------------------------------
# 按名字查找；已存在则就地更新为本配置（幂等），不存在则新建。
CONNECTOR_NAME=pgvector-rules-kb
KEY_NAME=pgvector-rules-kb-cred
# read_only | read_write（read_write 同时打开 allow_write）
CONNECTOR_PERMISSION=read_write
CONNECTOR_ALLOW_DDL=true
CONNECTOR_ALLOWED_SCHEMAS=public
CONNECTOR_MAX_ROWS=1000
# 连接器描述会出现在 Agent 的上下文里，Agent 靠它知道怎么用这个库；留空用内置默认文本（见 GUIDE.md）。
CONNECTOR_DESCRIPTION=

# ---- 7. 规则入库 -------------------------------------------------------------
# 规则原文（.docx，审批矩阵格式）的本地路径。原文属客户资料，不要放进本目录提交。
RULES_DOCX=/path/to/财务事项审批及授权管理办法V4.0-正式签批版A3-1015.docx
RULES_TABLE=approval_rules
# 同一份制度的标签。重新入库时，同标签下新版本里已经没有的规则会被删除（INGEST_PRUNE=true）。
RULES_SOURCE_TAG=finance-approval-v4
RULES_DOC_TITLE="《财务事项审批及授权管理办法》V4.0 正式签批版"
RULES_SOURCE_VERSION="V4.0 正式签批版（2026/9/30 初版，起草部门：财务部）"
# 写进 Agent 第 8 条规则的板块提示，Agent 遇到板块不明确时会列出这些板块请用户确认。
RULES_SEGMENTS_HINT="九安 / 柯顿 / 新零售 / O+O 等"
# 向量模型与维度：库里的 kb_embed / kb_embed_batch 用 PG 主机的实例角色调它（入库、检索都在库里算，本机不调）。
# us.cohere.embed-v4:0 是 Cohere Embed v4 的美国区推理配置文件（路由到 us-east-1 / us-east-2 / us-west-2）。
# 库里已有别的模型的向量时 db 会停下（防混用）：Titan 时代建的库换成 Cohere 用 ./deploy.sh db --migrate-embeddings（GUIDE.md 7.6）。
EMBED_MODEL_ID=us.cohere.embed-v4:0
EMBED_DIM=1024
# 入库时经 SSM 端口转发连 PG 使用的本机端口。
INGEST_LOCAL_PORT=15432
INGEST_PRUNE=true

# ---- 8. 审核 Agent -----------------------------------------------------------
# 要打补丁的 Agent（按 agent_name 查找）。补丁内容见 agent/prompt-rules.txt。
AGENT_NAME=jiuan_audit_ai_poc
# false = 不改 Agent 提示词（只部署数据层）。
AGENT_PATCH_PROMPT=true

# ---- 9. 端到端验证（./deploy.sh verify --e2e）---------------------------------
# 规则问答：回答里必须出现 E2E_EXPECT（规则编号）。
E2E_QUESTION="九安的一份采购合同，总金额 30 万，用印需要谁审批？审批顺序是怎样的？"
E2E_EXPECT=C03-1.2
# A2A 三段式回归：不绑连接器发一条三段式请求（<input> 里夹带「查库并写库」），回答必须是纯 JSON、
# verdict 合法，且没有调用任何写库 / 写文件 / 执行命令类工具（只读查询允许）。
E2E_A2A_REGRESSION=true
# 验证结束后把测试会话移到回收站。
E2E_CLEANUP_SESSIONS=true
