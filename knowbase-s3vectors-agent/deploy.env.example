# knowbase-s3vectors-agent 部署参数：复制成 deploy.env 再填写（deploy.env 不进仓库）
# 值里的 <…> 是占位符（样例里带着引号），整个换成真实值；还留着时管理员脚本会指出是哪一项。

# ── AWS：向量桶与写入身份 ──
AWS_REGION=us-east-1
# 向量桶名：3~63 位小写字母、数字、连字符。不要以 Nexus 环境前缀开头，也不要含
# -vectors-system / -vectors-agent / -vectors-avatar，否则 Nexus 会把它当成平台桶，连接器拒绝访问
VECTOR_BUCKET=knowbase-s3v-demo
# 写入身份：只对上面这个向量桶有读写权限的 IAM 用户。它的访问密钥请你在 IAM 控制台创建，直接填进 Nexus
WRITER_IAM_USER=knowbase-s3v-writer
# 可选：前端后端直连知识库时用的 IAM 用户（读写本桶 + 调 Cohere Embed v4）；留空就不建
APP_IAM_USER=
# 规则索引名（s3vectors_rules_tools.py：审批矩阵一行一条规则、一条一个向量）。不写就是 rules；
# 同一个桶里还有 chunks / docs / audit 和规则登记索引 rule-sources，不要和它们同名
RULES_INDEX=rules

# ── Nexus ──
NEXUS_URL='https://<env>.<domain>'
NEXUS_ADMIN_USER=admin
# 管理员密码来源（二选一）：本地 600 文件；或 <deployer 实例 ID>:<deploy.yaml 绝对路径>（经 SSM 读取 auth_password）
NEXUS_PASSWORD_FILE=
NEXUS_ADMIN_PASSWORD_SSM=
# Nexus Operator 的 profile（nexus.py --profile）
NEXUS_PROFILE=default
