{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "KnowbaseVectorBucket",
      "Effect": "Allow",
      "Action": ["s3vectors:GetVectorBucket", "s3vectors:ListIndexes"],
      "Resource": "arn:aws:s3vectors:__REGION__:__ACCOUNT_ID__:bucket/__VECTOR_BUCKET__"
    },
    {
      "Sid": "KnowbaseVectorIndexes",
      "Effect": "Allow",
      "Action": [
        "s3vectors:GetIndex",
        "s3vectors:PutVectors",
        "s3vectors:GetVectors",
        "s3vectors:ListVectors",
        "s3vectors:QueryVectors",
        "s3vectors:DeleteVectors"
      ],
      "Resource": "arn:aws:s3vectors:__REGION__:__ACCOUNT_ID__:bucket/__VECTOR_BUCKET__/index/*"
    }
  ]
}
