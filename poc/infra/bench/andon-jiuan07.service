# 测试台上的九安 v0.7.10（虚构数据；AI 独立建议经 A2A 交给 Nexus）。bench07-configure.sh 装到 /etc/systemd/system/。
# 以 jiuan07 用户运行：不在 andon 组，读不到 PoC 的 secrets.env；只听本机 127.0.0.1:4181，外面经 PoC 进程按 Host 转发进来。
# 九安的包是不可信的第三方代码：屏蔽实例元数据（实例角色能读构件桶里的 secrets.env），系统目录只读，出网由外壳的守卫和 /etc/hosts 管。
[Unit]
Description=Jiuan audit platform v0.7.10 test copy (fictitious data)
After=network-online.target docker.service andon-finance-poc.service
Wants=network-online.target docker.service

[Service]
Type=simple
User=jiuan07
Group=jiuan07
EnvironmentFile=/etc/andon-finance/jiuan07/env
WorkingDirectory=/var/lib/jiuan07
ExecStart=/usr/bin/node-24 /opt/andon-finance/current/app07/server.mjs
Restart=always
RestartSec=10
MemoryMax=1G
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/var/lib/jiuan07
IPAddressDeny=169.254.169.254 fd00:ec2::254

[Install]
WantedBy=multi-user.target
