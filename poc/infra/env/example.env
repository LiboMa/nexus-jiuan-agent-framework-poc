# 一个环境一份配置：cp poc/infra/env/example.env poc/infra/env/<环境名>.env && chmod 600 poc/infra/env/<环境名>.env
# 用法：DEPLOY_ENV=poc/infra/env/<环境名>.env bash poc/infra/deploy.sh（kb.sh、apply.py、setup.py、run.sh 同样）。
# 只有本文件进仓库；各环境的配置不进仓库、不进交付包。不放任何密码和密钥（口令在 secrets.env，Agent 的调用密钥在九安「Agent 接入」页上贴）。
# 规则：逐行 KEY=VALUE，值原样取（可以用一对 " 或 ' 包起来，不展开 $），不认识的键报错；空值等于没写（用模板的默认值或下面说的来源）。
# 下面的值是 AWS 文档的示例写法，照自己的环境改。指南：docs/delivery/test-deployment.md。

# ---- 栈与网络 ----
# CloudFormation 栈名（必填）
STACK=andon-finance-poc
# 区域（必填）；证书和 Bedrock 的模型访问也在这个区域
AWS_REGION=us-east-1
# Nexus 所在的 VPC，和其中一个公有子网：知识库的 PG 跑在这台实例上，Nexus 要能经私网连到它
VPC_ID=vpc-0123456789abcdef0
SUBNET_ID=subnet-0123456789abcdef0
# 实例类型：用 Graviton（arm64）的 m7g.xlarge（模板默认；前端、MySQL、知识库的 PG 都在这一台上）；也认 m7g.large 和 x86 的 t3.small / medium / large。
# 建栈时 deploy.sh 按类型的架构取 Amazon Linux 2023 的 AMI；栈建好后不能在 arm64 和 x86 之间换（要换就另建一个栈）
INSTANCE_TYPE=m7g.xlarge
# 根卷大小（GiB，模板默认 30）；MySQL 和 PG 的容器都在上面。栈建好后改它会替换实例
ROOT_VOLUME_SIZE=

# ---- 经 SSH 管理（不写就是经 SSM）----
# 下面四项一起写：实例带上这个 EC2 密钥对，安全组只对 SSH_ALLOWED_CIDR 开 22 端口；deploy.sh、kb.sh、run.sh 用 SSH_KEY_FILE 以 ec2-user 登录。
# SSH_KEY_NAME 在栈建好后改会替换实例
SSH_KEY_NAME=
# 本机私钥的绝对路径（权限 600；不展开 ~）。只给本机脚本用，不传给栈
SSH_KEY_FILE=
# 允许 SSH 的来源，一般是自己的公网地址 /32（curl https://checkip.amazonaws.com）；地址变了改这里再跑 deploy.sh（更新栈）
SSH_ALLOWED_CIDR=
# 怎么到 22 端口：direct（缺省，直连弹性 IP，来源是 SSH_ALLOWED_CIDR）或 eice（栈在 SUBNET_ID 里建一个 EC2 Instance Connect 端点，
# 一个 VPC 只能有一个；通道经 AWS API 的 HTTPS 走，还是 SSH + SSH_KEY_NAME，不用 SSM）。本机的网络连不到弹性 IP 时用 eice
SSH_VIA=
# 实例角色要不要带 AmazonSSMManagedInstanceCore：经 SSH 管理时写 false；不写就是 true
SSM_MANAGED=

# ---- 站点（一个 CloudFront 分发）----
# CloudFront 回源用的名字（指向实例的弹性 IP）
ORIGIN_DOMAIN_NAME=andon-finance-origin.example.com
# 九安 v0.7.10 测试台的站点（新前端）
DOMAIN_NAME=jiuan-v0710.example.com
# 上面两个名字所在的 Route 53 托管区
HOSTED_ZONE_ID=Z0123456789EXAMPLE
# us-east-1 的 ACM 证书，要覆盖 DOMAIN_NAME
CERTIFICATE_ARN=arn:aws:acm:us-east-1:123456789012:certificate/00000000-0000-0000-0000-000000000000
# com.amazonaws.global.cloudfront.origin-facing 前缀列表（每个区域不同；us-east-1 是 pl-3b927c52）
CLOUDFRONT_PREFIX_LIST_ID=pl-3b927c52

# ---- Nexus ----
# Nexus 的地址（https://，不带路径）
NEXUS_ORIGIN=https://nexus.example.com
# nexus-ai-operator 的配置名（skills/nexus-ai-operator，先 login 过）；apply.py、setup.py 用它调 Nexus
NEXUS_PROFILE=example

# ---- 知识库 ----
# 知识库的部署方式：pg（本机 PG 容器 + Nexus 数据连接器，kb.sh 部署）或 s3vectors（S3 Vectors + 知识库文档管家）；不写就是 pg。
# 两种方式下九安「制度知识库」页都经 Nexus 上的知识库 Agent（A2A）入库和检索，测试台不直连 PG
KB_MODE=pg
# 放行到 PG 端口的私网段（Nexus 的 API Server 和 Sandbox 节点所在的网段）；建栈时一起放行
KB_ALLOWED_CIDR=10.0.0.0/8
# kb.sh 的个人设置文件（相对仓库根目录；从 poc/infra/kb.env.example 复制）
KB_SETTINGS=poc/infra/kb.env
# 知识库的 Nexus 数据连接器（conn- 开头）：kb.sh connector 建好后，从 kb.sh status 抄过来
CONNECTOR_ID=
# PG 知识库 Agent 的发布（pub_ 加 16 位十六进制）：pg 方式「制度知识库」页经它入库和检索；调用密钥在「Agent 接入」页上启用；不写时页面说「知识库 Agent 还没配置」
KB_PG_PUBLICATION_ID=

# ---- 知识库：S3 Vectors 方式（KB_MODE=s3vectors 时下面五项都要写；pg 方式用不到）----
# S3 Vectors 的向量桶
KB_S3V_BUCKET=knowbase-s3v-example
# 规则索引（一条规则一个向量）
KB_S3V_RULES_INDEX=rules
# 规则工具在 Nexus 上的目录名（kb_s3v_rules_ 后跟导入时生成的一段十六进制）：knowbase-s3vectors-agent 导入规则模块（--module rules）后，从 .state/import-rules.json 的 dir_name 抄过来
RULES_TOOL_DIR=
# 文档管家写入密钥的编号（key- 加 12 位十六进制；只是编号，密钥本身不写在这里）
KB_S3V_KEY_ID=
# 知识库文档管家的发布（pub_ 加 16 位十六进制）：s3vectors 方式「制度知识库」页经它入库和检索；调用密钥在「Agent 接入」页上启用
KB_S3V_PUBLICATION_ID=

# ---- 审核 Agent ----
# Agent 的英文名（agent_name）、中文名和模型；不写就是下面这几个默认值
AGENT_NAME=jiuan_audit_ai_poc
AGENT_DISPLAY_NAME=九安审核AI（PoC）
AGENT_MODEL=global.anthropic.claude-opus-5-5
# 由 audit-agent/setup.py 建好后写回（agent_ 开头、pub_ 开头）
AGENT_ID=
PUBLICATION_ID=
