{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jiuan:agent:v1:task:describe:1:output",
  "title": "describe v1 输出",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tasks"
  ],
  "properties": {
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task",
          "versions",
          "title",
          "summary"
        ],
        "properties": {
          "task": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,40}$"
          },
          "versions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "title": {
            "type": "string",
            "maxLength": 60
          },
          "summary": {
            "type": "string",
            "maxLength": 500
          }
        }
      }
    }
  }
}
