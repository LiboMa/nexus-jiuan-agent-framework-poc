{
  "envelope": "jiuan.agent/v1",
  "task": "first_review",
  "version": 1,
  "title": "单据初审",
  "family": "process",
  "mode": "oneshot",
  "subjectKinds": [
    "document"
  ],
  "scopes": [
    "company"
  ],
  "trigger": {
    "system": true,
    "human": true,
    "roles": [
      "admin",
      "analyst"
    ]
  },
  "result": {
    "store": "per_subject",
    "partitioned": false
  },
  "routingFacts": [
    "documentType",
    "expenseType"
  ],
  "files": false,
  "deferred": false,
  "description": "按对这张单据有效的已发布规则逐条判断，给出每条和整张单据的「通过 / 不通过」和备注；之后由人复核。",
  "input": "input.schema.json",
  "output": "output.schema.json",
  "checks": [
    {
      "id": "rules-covered",
      "text": "请求里的每条规则（编号 + 版本）都有、且只有一条结果"
    },
    {
      "id": "engine-consistent",
      "text": "字段核对类（field_match）的结果和引擎一致：fail → fail，pass / not_applicable → pass"
    },
    {
      "id": "any-fail-fails",
      "text": "有任何一条不通过，综合结论就必须是不通过"
    }
  ],
  "outcome": {
    "field": "result",
    "labels": {
      "pass": "通过",
      "fail": "不通过"
    },
    "next": "人工复核（不论通过还是不通过）"
  },
  "staleWhen": [
    "subject.version"
  ],
  "flagWhen": [
    "rulesFingerprint",
    "evidence"
  ],
  "limits": {
    "maxRequestChars": 90000,
    "maxAnswerChars": 30000,
    "timeoutMs": 180000
  },
  "data": [
    "单据字段与明细",
    "已发布规则原文",
    "原件的脱敏页文字"
  ],
  "sideEffects": "none",
  "doc": "docs/delivery/first-review-contract.md"
}
