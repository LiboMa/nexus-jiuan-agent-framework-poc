{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jiuan:agent:v1:task:first_review:1:output",
  "title": "first_review v1 输出",
  "description": "单据初审的输出：综合结论、每条规则的结论和备注。放在结果信封的 output 里。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "result",
    "note",
    "rules"
  ],
  "properties": {
    "result": {
      "enum": [
        "pass",
        "fail"
      ],
      "description": "整张单据的综合结论：通过 / 不通过"
    },
    "note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "description": "综合备注：不通过时写清原因和要补什么"
    },
    "rules": {
      "type": "array",
      "maxItems": 60,
      "description": "请求里的每条规则都要有一条，不多不少",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ruleId",
          "ruleVersion",
          "result",
          "note"
        ],
        "properties": {
          "ruleId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,160}$"
          },
          "ruleVersion": {
            "type": "integer",
            "minimum": 1
          },
          "result": {
            "enum": [
              "pass",
              "fail"
            ],
            "description": "通过 / 不通过。与单据无关的规则算通过；缺材料或拿不准算不通过"
          },
          "note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "description": "备注：原因和依据（哪个字段、哪份原件第几页、引用的原文）"
          }
        }
      }
    }
  }
}
