{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jiuan:agent:v1:result",
  "title": "jiuan.agent/v1 结果信封",
  "description": "任何 Agent 的回答都只放这一个 JSON 对象（可以包在 ```json 代码块里）。completed 时 output 按任务契约的 output.schema.json；declined 表示 Agent 认为这个请求不归它做或做不了。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "envelope",
    "task",
    "taskVersion",
    "requestId",
    "status",
    "agentVersion"
  ],
  "properties": {
    "envelope": {
      "const": "jiuan.agent/v1"
    },
    "task": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,40}$"
    },
    "taskVersion": {
      "type": "integer",
      "minimum": 1
    },
    "requestId": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "enum": [
        "completed",
        "declined"
      ]
    },
    "output": {
      "type": "object",
      "description": "任务自己的输出"
    },
    "declined": {
      "type": "object",
      "required": [
        "reason"
      ],
      "additionalProperties": false,
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "agentVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "description": "Agent 自报的提示词版本"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        }
      },
      "then": {
        "required": [
          "output"
        ],
        "not": {
          "required": [
            "declined"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "declined"
          }
        }
      },
      "then": {
        "required": [
          "declined"
        ],
        "not": {
          "required": [
            "output"
          ]
        }
      }
    }
  ]
}
