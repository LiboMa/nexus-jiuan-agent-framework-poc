    pg["PG + pgvector 容器 nexus-pgvector<br/>私网 IP:5432 · 库 nexus · kb_search"]
  end
  subgraph nx["Nexus（nxs-beine1013）"]
    direction TB
    audit["九安审核AI（PoC）· 审批 Agent<br/>review_advice@1"]
