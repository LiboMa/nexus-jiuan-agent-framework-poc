flowchart LR
  q{"出了什么问题？"}
  code["应用代码<br/>回到上一版：previous 换回 current → 重启<br/>更早的：用那个提交 deploy.sh --code-only<br/>→ 健康检查 → 记 CHANGELOG"]
  key["Agent 调用密钥失效 →「Agent 接入」页「换钥匙」<br/>（不改文件、不部署、不重启）<br/>口令填错 → 改 secrets.env → deploy.sh --code-only<br/>（代码回滚不动密钥）"]
  param["栈参数改错<br/>改回原值 → deploy.sh --code-only"]
  tpl{"模板更新<br/>失败了？"}
  auto["CloudFormation 自动回滚<br/>什么都不用做"]
  tpl2["更新成功但有问题<br/>用上一版模板跑 deploy.sh"]
  prompt["审核 Agent 回答变差<br/>apply.py 下发上一版提示词<br/>（部署与迭代规范 6.3）"]
  q -- 新版本代码有问题 --> code
  q -- 密钥 --> key
  q -- 栈参数 --> param
  q -- 基础设施模板 --> tpl
  q -- Agent 提示词 --> prompt
  tpl -- 是 --> auto
  tpl -- 否 --> tpl2
  class q,tpl gate
  class code,key,param,tpl2,prompt poc
