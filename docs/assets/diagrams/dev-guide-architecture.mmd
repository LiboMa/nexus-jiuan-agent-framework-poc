flowchart TB
  subgraph tools["开发者的电脑：Claude Code / Codex / Kiro CLI"]
    direction LR
    op["nexus-ai-operator<br/>建 Agent · 试用 · 发布"]
    pr["提示词 · 下发脚本<br/>audit-agent/apply.py"]
  end
  subgraph jiuan["九安 v0.7.10（测试台上另打补丁 0001–0018）"]
    direction TB
    fe["页面：单据池 · AI 独立建议<br/>只调本站后端 · 不碰密钥"]
    adm["Agent 接入（管理员）<br/>启用 · 设为审批 Agent · 测试 · 调用记录"]
    svc["Agent 任务服务 src/agent-task-service.mjs<br/>流水线发起 · 人发起 · 存结果 · 自动重试"]
    mw["调用中间件 nexus-a2a<br/>额度 · 并发 · 时限 200 秒"]
    ad["A2A 适配层 providers/nexus-a2a.mjs<br/>发信封 · 收结果 · 按契约检查 · 映射错误码"]
    contract["契约 src/agent-contract/<br/>jiuan.agent/v1 · review_advice@1（180 秒）"]
  end
  subgraph nexus["Nexus"]
    direction TB
    pub["发布（A2A 打开）<br/>名片声明 review_advice@1"]
    agent["审核 Agent<br/>读请求信封 · 查知识库 · 回结果信封"]
  end
  fe --> svc --> mw --> ad
  adm -. 调用密钥（加密存库） .-> ad
  ad e1@== "A2A message/stream" ==> pub --> agent
  contract -. 校验请求与结果 .-> ad
  op -. 建、改、试用 .-> agent
  pr -. 写提示词、重存发布配置 .-> agent
  e1@{ animate: true }
  class op,pr poc
  class fe,adm,svc,mw,ad jiuan
  class pub,agent nexus
  class contract good
