flowchart LR
  p0["业务流程类<br/>流水线 / 工作流自动发起<br/>对象：一张单据"]
  f0["财务类<br/>人「运行一次」或定时<br/>对象：期间 / 一批单据"]
  k0["知识库类<br/>人在页面上发起<br/>可以多轮对话"]
  svc["Agent 任务服务 → 调用中间件 → A2A 适配层<br/>同一个信封 jiuan.agent/v1"]
  agents["Nexus 上的各个 Agent<br/>按任务契约干活"]
  p1["推进流程<br/>例如进入人工复核"]
  f1["报告页<br/>长任务稍后收结果"]
  k1["页面显示<br/>推荐的规则只是草稿，要人确认"]
  p0 --> svc
  f0 --> svc
  k0 --> svc
  svc <--> agents
  svc -- "业务流程类" --> p1
  svc -- "财务类" --> f1
  svc -- "知识库类" --> k1
  class p0,p1 jiuan
  class f0,f1 jiuan
  class k0,k1 jiuan
  class svc gate
  class agents nexus
