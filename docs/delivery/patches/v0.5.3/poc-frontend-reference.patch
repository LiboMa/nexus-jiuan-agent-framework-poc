+};
+
+/** 按任务调用的返回（{"task": …} 的 JSON）→ { task, blocks: [[标题, [行…]]] }；不是这种 JSON 时返回 null（例如审批建议、自由文本）。 */
+export function taskSummary(rawText) {
+  let value;
