# knowledgebase-writer-agent-pg 部署参数：复制成 deploy.env 再改（deploy.env 不进仓库）。
# 值里的 <…> 是占位符（样例里带着引号），整个换成真实值；还留着时管理员脚本会指出是哪一项。
# 这里只放不涉密的设置：数据库的连接字段由 Nexus 密钥注入（key_name=pg_kb，类型 database_credentials），不写在这里。

# 规则表（与 kb/deploy.env 的 RULES_TABLE 相同；审核 Agent 经连接器查的就是它）。小写字母、数字、下划线
RULES_TABLE=approval_rules

# ── Nexus（scripts/admin_run.sh：导入 / 发布工具、核对、绑定密钥、发调用密钥）──
NEXUS_URL='https://<env>.<domain>'
NEXUS_ADMIN_USER=admin
# 管理员密码来源（二选一）：本地 600 文件；或 <deployer 实例 ID>:<deploy.yaml 绝对路径>（经 SSM 读取 auth_password，
# 借同仓库 kb/ 的密封读取，SSM 命令历史里只有密文）
NEXUS_PASSWORD_FILE=
NEXUS_ADMIN_PASSWORD_SSM=
# SSM 方式所在的区域
AWS_REGION=us-east-1
